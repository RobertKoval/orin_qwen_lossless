TRITON_VERSION=3.5.0
FLASHINFER_VERSION=0.6.8
TRANSFORMERS_VERSION=4.57.6
# platform: Jetson AGX Orin 64 GB
CUDA=12.6
L4T=R36.5
GCC=11
SM=87
