From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Robert Koval <kovalrobert@me.com>
Date: Thu, 29 Oct 2026 19:59:37 +0200
Subject: [PATCH] llama: MTP draft with a sliding window and a vocabulary
 subset

LLAMA_MTP_SWA=<n>: the draft attends to its last n positions; LLAMA_MTP_VOCAB=<n>: the draft scores only token
ids below n.
---
 src/llama-model.cpp      | 27 ++++++++++++++++++++++++---
 src/models/qwen35moe.cpp | 24 +++++++++++++++++++++++-
 2 files changed, 47 insertions(+), 4 deletions(-)

diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index e358ad0495c488e7bef2bc0c862ad7cee21d8218..8e3eefd32e2964da7878f23d0ff7f9c67bc63295 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -3327,6 +3327,27 @@ llama_memory_i * llama_model::create_memory(const llama_memory_params & params,
                     } else {
                         GGML_ASSERT(!hparams.is_swa_any());
 
+                        // LLAMA_MTP_SWA=<n>: the MTP draft of a hybrid Qwen attends to its last n positions only. The
+                        // target verifies every drafted token, so the output does not change, while the draft's KV,
+                        // attention mask and attention work stop growing with the context.
+                        uint32_t       kv_size  = cparams.n_ctx_seq;
+                        uint32_t       n_swa    = hparams.n_swa;
+                        llama_swa_type swa_type = hparams.swa_type;
+                        if (const char * env = getenv("LLAMA_MTP_SWA"); env != nullptr && mtp_on_hybrid_qwen) {
+                            char * end = nullptr;
+                            const unsigned long n = strtoul(env, &end, 10);
+                            if (end == env || *end != '\0' || n == 0 || n >= cparams.n_ctx_seq) {
+                                throw std::runtime_error(format("LLAMA_MTP_SWA=%s: expected a window of 1..%u positions",
+                                                                env, cparams.n_ctx_seq - 1));
+                            }
+                            n_swa    = (uint32_t) n;
+                            swa_type = LLAMA_SWA_TYPE_STANDARD;
+                            kv_size  = std::min(kv_size, (uint32_t) GGML_PAD(
+                                n_swa*(cparams.kv_unified ? cparams.n_seq_max : 1) + cparams.n_ubatch, 256));
+                            LLAMA_LOG_INFO("%s: MTP draft attends to the last %u positions, KV cache of %u cells\n",
+                                           __func__, n_swa, kv_size);
+                        }
+
                         res = new llama_kv_cache(
                                 *this,
                                 params.no_alloc,
@@ -3336,10 +3357,10 @@ llama_memory_i * llama_model::create_memory(const llama_memory_params & params,
                                 !cparams.flash_attn,
                                 cparams.offload_kqv,
                                 cparams.kv_unified,
-                                cparams.n_ctx_seq,
+                                kv_size,
                                 cparams.n_seq_max,
-                                hparams.n_swa,
-                                hparams.swa_type,
+                                n_swa,
+                                swa_type,
                                 nullptr,
                                 filter,
                                 nullptr,
diff --git a/src/models/qwen35moe.cpp b/src/models/qwen35moe.cpp
index 939f10f7f061680336619f43907ab7c20bfbcc9b..e8fda4e32cfd4f78f86bc8704ed04f076642af6c 100644
--- a/src/models/qwen35moe.cpp
+++ b/src/models/qwen35moe.cpp
@@ -728,7 +728,29 @@ llama_model_qwen35moe::graph_mtp::graph_mtp(const llama_model & model, const llm
     ggml_tensor * head_w = layer.nextn.shared_head_head ? layer.nextn.shared_head_head : model.output;
     ggml_tensor * head_s = layer.nextn.shared_head_head ? layer.nextn.shared_head_head_s : model.output_s;
     GGML_ASSERT(head_w && "QWEN35MOE MTP: missing LM head (nextn.shared_head_head or model.output)");
-    cur = build_lora_mm(head_w, cur, head_s);
+
+    // LLAMA_MTP_VOCAB=<n>: the draft scores only the first n token ids (BPE ids run roughly from frequent to rare) and
+    // the rest get -inf. A token outside them is never drafted; the target still verifies every token, so the output
+    // does not change, while the draft's head reads n rows of the output matrix instead of all of them.
+    static const int64_t n_head = [] {
+        const char * env = getenv("LLAMA_MTP_VOCAB");
+        if (env == nullptr) {
+            return (int64_t) 0;
+        }
+        char * end = nullptr;
+        const long long n = strtoll(env, &end, 10);
+        if (end == env || *end != '\0' || n <= 0 || n % 256 != 0) {
+            GGML_ABORT("LLAMA_MTP_VOCAB=%s: expected a positive multiple of 256", env);
+        }
+        return (int64_t) n;
+    }();
+    if (n_head > 0 && n_head < head_w->ne[1] && head_s == nullptr) {
+        ggml_tensor * scored = ggml_mul_mat(ctx0, ggml_view_2d(ctx0, head_w, head_w->ne[0], n_head, head_w->nb[1], 0), cur);
+        ggml_tensor * masked = ggml_fill(ctx0, ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, head_w->ne[1] - n_head, cur->ne[1]), -INFINITY);
+        cur = ggml_concat(ctx0, scored, masked, 0);
+    } else {
+        cur = build_lora_mm(head_w, cur, head_s);
+    }
     cb(cur, "result_output", -1);
 
     res->t_logits = cur;
