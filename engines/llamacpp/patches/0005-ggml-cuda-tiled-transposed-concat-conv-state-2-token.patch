From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Robert Koval <kovalrobert@me.com>
Date: Thu, 29 Oct 2026 19:59:37 +0200
Subject: [PATCH] ggml-cuda: tiled transposed concat (conv state + 2-token MTP
 batches)

A 32x32 shared-memory tile so both the transposed src1 reads and the dst writes coalesce; test-backend-ops cases.
---
 ggml/src/ggml-cuda/concat.cu | 62 ++++++++++++++++++++++++++++++++++++
 tests/test-backend-ops.cpp   | 14 ++++++++
 2 files changed, 76 insertions(+)

diff --git a/ggml/src/ggml-cuda/concat.cu b/ggml/src/ggml-cuda/concat.cu
index f8dcd95ab008b6307244882c7dcdf14fb03b25c4..662fe17eb962c27338989516ee3af8c002dcb4fd 100644
--- a/ggml/src/ggml-cuda/concat.cu
+++ b/ggml/src/ggml-cuda/concat.cu
@@ -139,8 +139,70 @@ static __global__ void __launch_bounds__(CUDA_CONCAT_BLOCK_SIZE)
     }
 }
 
+// dim 0 with a transposed src1 (unit stride along dim 1), e.g. the recurrent conv state prepended to transpose(x):
+// a 32x32 tile goes through shared memory so both the src1 reads (along dim 1) and the dst writes (along dim 0) coalesce.
+// Blocks of the first tile column also copy the ne00 leading elements of each row from src0.
+#define CUDA_CONCAT_TILE 32
+#define CUDA_CONCAT_TILE_ROWS 8
+
+template <typename T>
+static __global__ void __launch_bounds__(CUDA_CONCAT_TILE * CUDA_CONCAT_TILE_ROWS)
+    concat_dim0_transposed(
+        const char * src0, const char * src1, char * dst,
+        int64_t ne00, int64_t ne10, int64_t ne11, int64_t ne12,
+        uint64_t nb00, uint64_t nb01, uint64_t nb02, uint64_t nb03,
+        uint64_t nb10, uint64_t nb11, uint64_t nb12, uint64_t nb13,
+        uint64_t nb0, uint64_t nb1, uint64_t nb2, uint64_t nb3) {
+    __shared__ T tile[CUDA_CONCAT_TILE][CUDA_CONCAT_TILE + 1];
+
+    const int64_t i3 = blockIdx.z / ne12;
+    const int64_t i2 = blockIdx.z - i3 * ne12;
+    const int64_t t0 = (int64_t) blockIdx.x * CUDA_CONCAT_TILE; // position along src1 dim 0
+    const int64_t c0 = (int64_t) blockIdx.y * CUDA_CONCAT_TILE; // dim 1
+    const int tx = threadIdx.x, ty = threadIdx.y;
+
+    const char * s1 = src1 + i3*nb13 + i2*nb12;
+    char       * d  = dst  + i3*nb3  + i2*nb2;
+
+#pragma unroll
+    for (int j = ty; j < CUDA_CONCAT_TILE; j += CUDA_CONCAT_TILE_ROWS) {
+        if (t0 + j < ne10 && c0 + tx < ne11) {
+            tile[j][tx] = *(const T *) (s1 + (t0 + j)*nb10 + (c0 + tx)*nb11);
+        }
+    }
+    __syncthreads();
+#pragma unroll
+    for (int j = ty; j < CUDA_CONCAT_TILE; j += CUDA_CONCAT_TILE_ROWS) {
+        if (c0 + j < ne11 && t0 + tx < ne10) {
+            *(T *) (d + (ne00 + t0 + tx)*nb0 + (c0 + j)*nb1) = tile[tx][j];
+        }
+    }
+
+    if (blockIdx.x == 0) {
+        const char * s0 = src0 + i3*nb03 + i2*nb02;
+        for (int k = ty * CUDA_CONCAT_TILE + tx; k < ne00 * CUDA_CONCAT_TILE; k += CUDA_CONCAT_TILE * CUDA_CONCAT_TILE_ROWS) {
+            const int64_t i0 = k % ne00, i1 = c0 + k / ne00;
+            if (i1 < ne11) {
+                *(T *) (d + i0*nb0 + i1*nb1) = *(const T *) (s0 + i0*nb00 + i1*nb01);
+            }
+        }
+    }
+}
+
 template <typename T>
 static void concat_cuda(const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst, int dim, cudaStream_t stream) {
+    if (dim == 0 && src1->nb[1] == sizeof(T) && src1->nb[0] > sizeof(T) && !ggml_is_quantized(src0->type) &&
+        src1->ne[0] > 1 && src1->ne[1] >= CUDA_CONCAT_TILE) { // a single token (decode) stays generic (contiguous)
+        const dim3 grid((src1->ne[0] + CUDA_CONCAT_TILE - 1) / CUDA_CONCAT_TILE, (src1->ne[1] + CUDA_CONCAT_TILE - 1) / CUDA_CONCAT_TILE,
+                        src1->ne[2] * src1->ne[3]);
+        concat_dim0_transposed<T><<<grid, dim3(CUDA_CONCAT_TILE, CUDA_CONCAT_TILE_ROWS), 0, stream>>>(
+            (const char *) src0->data, (const char *) src1->data, (char *) dst->data,
+            src0->ne[0], src1->ne[0], src1->ne[1], src1->ne[2],
+            src0->nb[0], src0->nb[1], src0->nb[2], src0->nb[3],
+            src1->nb[0], src1->nb[1], src1->nb[2], src1->nb[3],
+            dst->nb[0], dst->nb[1], dst->nb[2], dst->nb[3]);
+        return;
+    }
     if (dim != 3 && ggml_is_contiguous_to_3(src0) && ggml_is_contiguous_to_3(src1)) {
         const T * src0_d = (const T *) src0->data;
         const T * src1_d = (const T *) src1->data;
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index d5133bde7c2d7568701aa8306ef7a04366494802..c066e69430ae52ef1cfdeee7b0952151a9ac128f 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -11845,6 +11845,20 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
         }
     }
 
+    for (ggml_type type : { GGML_TYPE_F32, GGML_TYPE_F16, GGML_TYPE_BF16, GGML_TYPE_I32 }) {
+        for (int v : { 16, 17 }) { // transposed b along dim 0, partial tiles
+            test_cases.emplace_back(new test_concat(type, {3, 96, 4, 2}, 70, 0, v));
+            test_cases.emplace_back(new test_concat(type, {3, 1000, 1, 1}, 300, 0, v));
+            for (int n : { 31, 32, 33 }) { // around the one-tile threshold of the tiled path, in both dims of b
+                test_cases.emplace_back(new test_concat(type, {3, 32, 1, 1}, n, 0, v));
+                if (n != 32) {
+                    test_cases.emplace_back(new test_concat(type, {3, n, 1, 1}, 32, 0, v));
+                }
+            }
+            test_cases.emplace_back(new test_concat(type, {3, 1000, 1, 1}, 1, 0, v)); // one token (decode)
+        }
+    }
+
     for (ggml_type type_a : { GGML_TYPE_Q4_0, GGML_TYPE_Q4_1, GGML_TYPE_Q5_0, GGML_TYPE_Q5_1, GGML_TYPE_Q8_0 }) {
         for (int v : { 0, 4, 8, 12 }) {
             for (int dim : { 0, 1, 2, 3, }) {
