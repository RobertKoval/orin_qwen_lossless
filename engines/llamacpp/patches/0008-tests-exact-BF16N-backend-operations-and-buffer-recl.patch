 static void usage(char ** argv) {
     printf("Usage: %s [mode] [options]\n\n", argv[0]);
     printf("Valid modes:\n");
     printf("  test     (default) compare with CPU backend for correctness\n");
+    printf("  bf16n    exact BF16N MUL_MAT/MUL_MAT_ID/GET_ROWS/GLU checks; only option: -b backend\n");
     printf("  grad     compare gradients from backpropagation with method of finite differences\n");
     printf("  perf     performance evaluation\n");
     printf("  support  probe backend operation support\n\n");
@@ -13587,6 +13590,12 @@ static void usage(char ** argv) {
 }
 
 int main(int argc, char ** argv) {
+    if (argc >= 2 && strcmp(argv[1], "bf16n") == 0) {
+        if (argc == 2) { return bf16n_tests::run("CUDA0"); }
+        if (argc == 4 && strcmp(argv[2], "-b") == 0) { return bf16n_tests::run(argv[3]); }
+        usage(argv);
+        return 1;
+    }
     test_mode mode = MODE_TEST;
     output_formats output_format = CONSOLE;
     const char * op_names_filter = nullptr;
