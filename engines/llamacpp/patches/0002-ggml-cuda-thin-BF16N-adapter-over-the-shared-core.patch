+
     if (GGML_CUDA_GRAPHS)
         add_compile_definitions(GGML_CUDA_USE_GRAPHS)
     endif()
diff --git a/ggml/src/ggml-cuda/bf16n.cu b/ggml/src/ggml-cuda/bf16n.cu
new file mode 100644
index 0000000000000000000000000000000000000000..ffaa4fd5dc990c27639e3b2e6cd7c3b3547990f8
--- /dev/null
+++ b/ggml/src/ggml-cuda/bf16n.cu
@@ -0,0 +1,286 @@
+// SPDX-License-Identifier: MIT
+// ggml ownership, views, environment switches and workspace glue for the shared BF16N core.
+#include "bf16n.cuh"
+#include "convert.cuh"
+#include "bf16n/encode.h"
+#include "bf16n/launch.h"
+#include "bf16n/policy.h"
+
+#include <algorithm>
+#include <cstring>
+#include <functional>
+#include <mutex>
+#include <optional>
+#include <vector>
+
+namespace {
+
+static_assert(GGML_BF16N_NIBBLE == bf16n::FMT_NIBBLE && GGML_BF16N_HUFFMAN == bf16n::FMT_HUFFMAN &&
+              GGML_BF16N_HUFPAIR == bf16n::FMT_HUFPAIR, "ggml conversion tags must match the core format");
+
+struct entry : bf16n::weight {
+    size_t nbytes = 0;
+    ggml_backend_buffer_t owner = nullptr;
+};
+
+std::mutex g_mutex;
+std::vector<entry> g_entries;
+
+// Return metadata by value: loading/unloading another model can move the registry's entries.
+std::optional<entry> lookup(const void * p, int64_t & row0) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    const auto q = static_cast<const uint8_t *>(p);
+    const auto less = std::less<const uint8_t *>{};
+    auto it = std::upper_bound(g_entries.begin(), g_entries.end(), q,
+        [&](const uint8_t * a, const entry & e) { return less(a, e.plane); });
+    if (it == g_entries.begin()) {
+        return std::nullopt;
+    }
+    --it;
+    if (!less(q, it->plane + it->nbytes)) {
+        return std::nullopt;
+    }
+    const size_t off = q - it->plane;
+    GGML_ASSERT(off % it->K == 0);
+    row0 = off / it->K;
+    return *it;
+}
+
+bf16n::mmv_args make_cols(const ggml_tensor * src0, int64_t row0, const ggml_tensor * src1,
+        const ggml_tensor * ids, const ggml_tensor * dst) {
+    bf16n::mmv_args p;
+    p.x = src1->data;
+    p.y = dst->data;
+    p.rows_per_matrix = src0->ne[1];
+    p.row0 = row0;
+    p.nrows = src0->ne[1];
+    if (ids) {
+        p.ids = ids->data;
+        p.ids_s0 = ids->nb[0]; p.ids_s1 = ids->nb[1];
+        p.n_used = (int) ids->ne[0];
+        p.x_per_slot = (int) src1->ne[1];
+        p.x_slot = src1->nb[1]; p.x_tok = src1->nb[2];
+        p.y_slot = dst->nb[1]; p.y_tok = dst->nb[2];
+        p.ncols = (int) (ids->ne[0] * ids->ne[1]);
+    } else {
+        GGML_ASSERT(src0->ne[2] == 1 && src0->ne[3] == 1 && src1->ne[2] == 1 && src1->ne[3] == 1);
+        p.x_tok = src1->nb[1];
+        p.y_tok = dst->nb[1];
+        p.ncols = (int) src1->ne[1];
+    }
+    return p;
+}
+
+} // namespace
+
+// Called before the owning CUDA buffer is freed; views do not own auxiliary storage.
+void ggml_cuda_bf16n_free(ggml_backend_buffer_t buffer) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    for (auto it = g_entries.begin(); it != g_entries.end();) {
+        if (it->owner == buffer) {
+            CUDA_CHECK(cudaFree(const_cast<uint8_t *>(it->aux)));
+            it = g_entries.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
+
+bool ggml_cuda_bf16n_mul_mat_vec(ggml_backend_cuda_context & ctx, const ggml_tensor * src0,
+        const ggml_tensor * src1, const ggml_tensor * ids, ggml_tensor * dst) {
+    int64_t row0 = 0;
+    const auto e = lookup(src0->data, row0);
+    GGML_ASSERT(e && "BF16N tensor without registered aux data");
+    GGML_ASSERT(src0->ne[0] == e->K && src1->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(src1->nb[0] == sizeof(float));
+    auto p = make_cols(src0, row0, src1, ids, dst);
+    static const bool no_multi_col = getenv("GGML_BF16N_NO_MULTI_COL") != nullptr;
+    bf16n::mmv(*e, p, ctx.stream(), !no_multi_col);
+    return true;
+}
+
+bool ggml_cuda_bf16n_can_fuse_glu(const ggml_tensor * gate_w, const ggml_tensor * up_w,
+        const ggml_tensor * src1, const ggml_tensor * ids, const ggml_tensor * glu) {
+    if (gate_w->type != GGML_TYPE_BF16N || up_w->type != GGML_TYPE_BF16N ||
+            src1->type != GGML_TYPE_F32 || glu->type != GGML_TYPE_F32) {
+        return false;
+    }
+    static const bool no_glu = getenv("GGML_BF16N_NO_GLU") != nullptr;
+    if (no_glu || ggml_get_glu_op(glu) != GGML_GLU_OP_SWIGLU || ggml_get_op_params_i32(glu, 1) != 0 ||
+            !ggml_are_same_shape(gate_w, up_w) || src1->nb[0] != sizeof(float)) {
+        return false;
+    }
+    const int64_t ncols = ids ? ids->ne[0] * ids->ne[1] : src1->ne[1];
+    if ((ids ? ids->ne[1] : src1->ne[1]) > 8 || ncols > 64) {
+        return false;
+    }
+    int64_t rg = 0, ru = 0;
+    const auto g = lookup(gate_w->data, rg);
+    const auto u = lookup(up_w->data, ru);
+    if (!g || !u || g->format != u->format || g->K != u->K || rg != 0 || ru != 0 || g->cm || u->cm) {
+        return false;
+    }
+    if (g->format == GGML_BF16N_NIBBLE) {
+        return true;
+    }
+    if (g->R != u->R) {
+        return false;
+    }
+    static const bool hp_glu = getenv("GGML_BF16N_HP_GLU") != nullptr;
+    if (g->format == GGML_BF16N_HUFPAIR && !hp_glu) {
+        return false;
+    }
+    return g->format == GGML_BF16N_HUFPAIR ? (g->R & (g->R - 1)) == 0 && g->R <= 16 : (g->R == 8 || g->R == 16);
+}
+
+void ggml_cuda_bf16n_mul_mat_vec_glu(ggml_backend_cuda_context & ctx, const ggml_tensor * gate_w,
+        const ggml_tensor * up_w, const ggml_tensor * src1, const ggml_tensor * ids, ggml_tensor * glu) {
+    int64_t rg = 0, ru = 0;
+    const auto g = lookup(gate_w->data, rg);
+    const auto u = lookup(up_w->data, ru);
+    GGML_ASSERT(g && u);
+    bf16n::mmv_glu(*g, *u, make_cols(up_w, 0, src1, ids, glu), ctx.stream());
+}
+
+bool ggml_cuda_bf16n_mul_mat_id_supported(const ggml_tensor * src0, const ggml_tensor * src1,
+        const ggml_tensor * ids, const ggml_tensor * dst) {
+    static const bool off = getenv("GGML_BF16N_NO_MMA") != nullptr;
+    if (off || ggml_cuda_bf16n_reference()) {
+        return false;
+    }
+    int64_t row0 = 0;
+    const auto e = lookup(src0->data, row0);
+    return e && bf16n::mm_ids_supported(*e, nullptr) && row0 == 0 && e->rows == src0->ne[1] * src0->ne[2] &&
+        src0->ne[1] % e->R == 0 && src0->ne[3] == 1 && src1->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 &&
+        ggml_is_contiguous(src1) && ggml_is_contiguous(dst) && ids->type == GGML_TYPE_I32 && ids->nb[0] == sizeof(int32_t);
+}
+
+static void ggml_cuda_bf16n_mul_mat_id_impl(ggml_backend_cuda_context & ctx, const ggml_tensor * src0,
+        const entry * u, const ggml_tensor * src1, const ggml_tensor * ids, ggml_tensor * dst) {
+    int64_t row0 = 0;
+    const auto e = lookup(src0->data, row0);
+    GGML_ASSERT(e);
+    cudaStream_t stream = ctx.stream();
+    const int n_used = (int) ids->ne[0], n_tok = (int) ids->ne[1], n_experts = (int) src0->ne[2];
+    ggml_cuda_pool_alloc<int32_t> ids_src1(ctx.pool(), (size_t) n_used * n_tok);
+    ggml_cuda_pool_alloc<int32_t> ids_dst(ctx.pool(), (size_t) n_used * n_tok);
+    ggml_cuda_pool_alloc<int32_t> bounds(ctx.pool(), n_experts + 1);
+    bf16n::mm_ids_route(ids->data, false, ids->nb[1] / sizeof(int32_t), ids_src1.get(), ids_dst.get(), bounds.get(),
+        n_experts, n_tok, n_used, (int) src1->ne[1], (int) (src1->nb[2] / src1->nb[1]), stream);
+    ggml_cuda_pool_alloc<nv_bfloat16> x(ctx.pool(), ggml_nelements(src1));
+    ggml_get_to_bf16_cuda(GGML_TYPE_F32)(src1->data, x.get(), ggml_nelements(src1), stream);
+    bf16n::mm_ids(*e, u, x.get(), src1->ne[0], ids_src1.get(), ids_dst.get(), bounds.get(), dst->data, false,
+        dst->ne[0], n_experts, n_tok, n_used, stream);
+}
+
+void ggml_cuda_bf16n_mul_mat_id(ggml_backend_cuda_context & ctx, const ggml_tensor * src0,
+        const ggml_tensor * src1, const ggml_tensor * ids, ggml_tensor * dst) {
+    ggml_cuda_bf16n_mul_mat_id_impl(ctx, src0, nullptr, src1, ids, dst);
+}
+
+bool ggml_cuda_bf16n_mul_mat_id_glu_supported(const ggml_tensor * gate_w, const ggml_tensor * up_w,
+        const ggml_tensor * src1, const ggml_tensor * ids, const ggml_tensor * glu) {
+    static const bool no_glu = getenv("GGML_BF16N_NO_GLU") != nullptr;
+    if (no_glu || ggml_get_glu_op(glu) != GGML_GLU_OP_SWIGLU || ggml_get_op_params_i32(glu, 1) != 0 || ids->ne[1] <= 8 ||
+            gate_w->type != GGML_TYPE_BF16N || up_w->type != GGML_TYPE_BF16N || !ggml_are_same_shape(gate_w, up_w) ||
+            glu->type != GGML_TYPE_F32 || !ggml_is_contiguous(glu) || glu->ne[0] != gate_w->ne[1] ||
+            !ggml_cuda_bf16n_mul_mat_id_supported(gate_w, src1, ids, glu) ||
+            !ggml_cuda_bf16n_mul_mat_id_supported(up_w, src1, ids, glu)) {
+        return false;
+    }
+    int64_t rg = 0, ru = 0;
+    const auto g = lookup(gate_w->data, rg);
+    const auto u = lookup(up_w->data, ru);
+    return bf16n::mm_ids_supported(*g, &*u);
+}
+
+void ggml_cuda_bf16n_mul_mat_id_glu(ggml_backend_cuda_context & ctx, const ggml_tensor * gate_w,
+        const ggml_tensor * up_w, const ggml_tensor * src1, const ggml_tensor * ids, ggml_tensor * glu) {
+    int64_t ru = 0;
+    const auto u = lookup(up_w->data, ru);
+    GGML_ASSERT(u);
+    ggml_cuda_bf16n_mul_mat_id_impl(ctx, gate_w, &*u, src1, ids, glu);
+}
+
+void ggml_cuda_bf16n_dequant_bf16(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, void * out) {
+    int64_t row0 = 0;
+    const auto e = lookup(src0->data, row0);
+    GGML_ASSERT(e && ggml_is_contiguous(src0));
+    bf16n::dequant(*e, row0, ggml_nrows(src0), static_cast<uint16_t *>(out), ctx.stream());
+}
+
+void ggml_cuda_bf16n_get_rows(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    int64_t row0 = 0;
+    const auto e = lookup(src0->data, row0);
+    GGML_ASSERT(e && !e->cm);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && src1->type == GGML_TYPE_I32 && dst->nb[0] == sizeof(float));
+    GGML_ASSERT(src1->ne[1] == 1 && src1->ne[2] == 1 && src1->ne[3] == 1 && src0->ne[2] == 1 && src0->ne[3] == 1);
+    bf16n::get_rows(*e, src1->data, src1->nb[0], src1->ne[0], dst->data, false, dst->nb[1], ctx.stream(), row0);
+}
+
+bool ggml_cuda_bf16n_is_registered(const ggml_tensor * t) {
+    int64_t row0 = 0;
+    return lookup(t->data, row0).has_value();
+}
+
+extern "C" int ggml_backend_cuda_bf16n_choose(int64_t rows, int64_t K, int64_t n_matrices,
+        const char * mode, int64_t dense_min, bool expert) {
+    const auto requested = strcmp(mode, "nibble") == 0 ? bf16n::policy_mode::nibble :
+        strcmp(mode, "huffman") == 0 ? bf16n::policy_mode::huffman : bf16n::policy_mode::hybrid;
+    const auto c = bf16n::choose(rows, K, n_matrices,
+        {bf16n::policy_engine::llama, requested, dense_min, expert});
+    // Keep the existing conversion ABI: 2 means pair Huffman with single-symbol fallback.
+    return !c ? 0 : c->format == bf16n::FMT_NIBBLE ? GGML_BF16N_NIBBLE : GGML_BF16N_HUFFMAN;
+}
+
+extern "C" bool ggml_backend_cuda_bf16n_convert(ggml_tensor * tensor, const void * bf16_host, int format) {
+    GGML_ASSERT(tensor->type == GGML_TYPE_BF16N && ggml_is_contiguous(tensor) && tensor->buffer);
+    const int64_t K = tensor->ne[0], rows = ggml_nrows(tensor);
+    const auto * w = static_cast<const uint16_t *>(bf16_host);
+    // The explicit format is part of ggml's conversion ABI; choose tuning with the llama shape policy.
+    const auto policy = bf16n::choose(tensor->ne[1], K, tensor->ne[2],
+        {bf16n::policy_engine::llama,
+         format == GGML_BF16N_NIBBLE ? bf16n::policy_mode::nibble : bf16n::policy_mode::huffman});
+    GGML_ASSERT(policy.has_value());
+    auto encoded = bf16n::encode(w, rows, K, policy->format, policy->R, policy->chunk_major);
+    CUDA_CHECK(cudaMemcpy(tensor->data, encoded.plane.data(), encoded.plane.size(), cudaMemcpyHostToDevice));
+    void * aux_dev = nullptr;
+    CUDA_CHECK(cudaMalloc(&aux_dev, encoded.aux.size()));
+    CUDA_CHECK(cudaMemcpy(aux_dev, encoded.aux.data(), encoded.aux.size(), cudaMemcpyHostToDevice));
+    const auto & h = *reinterpret_cast<const bf16n::aux_header *>(encoded.aux.data());
+    entry e;
+    e.plane = static_cast<const uint8_t *>(tensor->data);
+    e.aux = static_cast<const uint8_t *>(aux_dev);
+    e.nbytes = encoded.plane.size(); e.owner = tensor->buffer;
+    e.format = encoded.format; e.K = K; e.rows = rows; e.R = encoded.R;
+    e.cm = (h.flags & bf16n::FLAG_CHUNK_MAJOR) != 0;
+    e.off_a = h.off_a; e.off_b = h.off_b; e.off_c = h.off_c; e.off_d = h.off_d;
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        const auto less = std::less<const uint8_t *>{};
+        auto it = std::upper_bound(g_entries.begin(), g_entries.end(), e.plane,
+            [&](const uint8_t * p, const entry & v) { return less(p, v.plane); });
+        g_entries.insert(it, e);
+    }
+    // Exhaustive bitwise roundtrip, bounded to a 64 MiB device workspace.
+    const int R = std::max(e.R, 1);
+    const int64_t chunk_rows = std::max<int64_t>((64ll << 20) / (K * 2) / R * R, R);
+    uint16_t * d_out = nullptr;
+    CUDA_CHECK(cudaMalloc(&d_out, chunk_rows * K * 2));
+    std::vector<uint16_t> back(chunk_rows * K);
+    bool ok = true;
+    for (int64_t r0 = 0; r0 < rows && ok; r0 += chunk_rows) {
+        const int64_t nr = std::min(chunk_rows, rows - r0);
+        bf16n::dequant(e, r0, nr, d_out, 0);
+        CUDA_CHECK(cudaMemcpy(back.data(), d_out, nr * K * 2, cudaMemcpyDeviceToHost));
+        ok = memcmp(back.data(), w + r0 * K, nr * K * 2) == 0;
+    }
+    CUDA_CHECK(cudaFree(d_out));
+    const double ratio = double(encoded.plane.size() + encoded.aux.size()) / double(rows * K * 2);
+    fprintf(stderr, "bf16n: %-32s %s K=%5lld rows=%7lld R=%2d ratio=%.4f roundtrip=%s\n", tensor->name,
+        e.format == GGML_BF16N_HUFPAIR ? "hufpair" : e.format == GGML_BF16N_HUFFMAN ? "huffman" : "nibble ",
+        (long long) K, (long long) rows, e.R, ratio, ok ? "OK" : "FAIL");
+    return ok;
+}
diff --git a/ggml/src/ggml-cuda/bf16n.cuh b/ggml/src/ggml-cuda/bf16n.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..340f34b66851fb42893fcbae8b1a8fe4890786cf
--- /dev/null
+++ b/ggml/src/ggml-cuda/bf16n.cuh
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include "common.cuh"
+
+// aux formats of GGML_TYPE_BF16N tensors (see bf16n.cu)
+#define GGML_BF16N_NIBBLE  1
+#define GGML_BF16N_HUFFMAN 2
+#define GGML_BF16N_HUFPAIR 3 // Huffman over exponent pairs (chosen automatically when the pair alphabet fits)
+
+// GGML_BF16N_REFERENCE=1: route every BF16N product through exact dequant + the stock BF16 cuBLAS path
+static inline bool ggml_cuda_bf16n_reference() {
+    static const bool on = getenv("GGML_BF16N_REFERENCE") != nullptr;
+    return on;
+}
+
+// y = W x for up to 8 columns; ids != nullptr for MUL_MAT_ID
+bool ggml_cuda_bf16n_mul_mat_vec(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1,
+                                 const ggml_tensor * ids, ggml_tensor * dst);
+
+// fused gate/up + SWIGLU (MUL_MAT, MUL_MAT, GLU or MUL_MAT_ID, MUL_MAT_ID, GLU)
+bool ggml_cuda_bf16n_can_fuse_glu(const ggml_tensor * gate_w, const ggml_tensor * up_w, const ggml_tensor * src1,
+                                  const ggml_tensor * ids, const ggml_tensor * glu);
+void ggml_cuda_bf16n_mul_mat_vec_glu(ggml_backend_cuda_context & ctx, const ggml_tensor * gate_w, const ggml_tensor * up_w,
+                                     const ggml_tensor * src1, const ggml_tensor * ids, ggml_tensor * glu);
+
+// MUL_MAT_ID with more than 8 tokens (prefill): decode in shared memory + BF16 tensor cores, routing on the GPU (no sync)
+bool ggml_cuda_bf16n_mul_mat_id_supported(const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * ids,
+                                          const ggml_tensor * dst);
+void ggml_cuda_bf16n_mul_mat_id(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1,
+                                const ggml_tensor * ids, ggml_tensor * dst);
+// the same for gate and up of MUL_MAT_ID, MUL_MAT_ID, GLU(SWIGLU) in one kernel: dst = the GLU output
+bool ggml_cuda_bf16n_mul_mat_id_glu_supported(const ggml_tensor * gate_w, const ggml_tensor * up_w, const ggml_tensor * src1,
+                                              const ggml_tensor * ids, const ggml_tensor * glu);
+void ggml_cuda_bf16n_mul_mat_id_glu(ggml_backend_cuda_context & ctx, const ggml_tensor * gate_w, const ggml_tensor * up_w,
+                                    const ggml_tensor * src1, const ggml_tensor * ids, ggml_tensor * glu);
+
+// GET_ROWS with a BF16N source (token embedding), F32 destination
+void ggml_cuda_bf16n_get_rows(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
+
+// exact BF16 reconstruction of a (row-aligned, contiguous) BF16N tensor or view into `out`
+void ggml_cuda_bf16n_dequant_bf16(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, void * out);
+
+// Release auxiliary buffers with their ggml allocation (not individual tensor views).
