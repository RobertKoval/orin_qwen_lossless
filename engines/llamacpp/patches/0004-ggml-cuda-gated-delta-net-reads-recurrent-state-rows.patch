index ae2374cbcdd79b3383d622b85d3d6a086c8d5e5e..56d4ff0319dfab1a63762ff43426d2bbc1b10cdd 100644
--- a/ggml/src/ggml-cuda/gated_delta_net.cu
+++ b/ggml/src/ggml-cuda/gated_delta_net.cu
@@ -14,6 +14,8 @@ gated_delta_net_cuda(const float * q,
                                      const float * g,
