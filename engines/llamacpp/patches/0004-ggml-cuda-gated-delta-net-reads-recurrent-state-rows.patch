From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Robert Koval <kovalrobert@me.com>
Date: Thu, 29 Oct 2026 19:59:37 +0200
Subject: [PATCH] ggml-cuda: gated delta net reads recurrent-state rows in
 place; MMA path on Orin

The GET_ROWS gather of a single sequence state is fused into the GDN kernels when the row ids outlive the GDN
node (GGML_CUDA_NO_GDN_ROWS disables it); the tensor-core GDN schedule is enabled for SM87.
---
 ggml/src/ggml-cuda/common.cuh              |  3 +
 ggml/src/ggml-cuda/gated-delta-net-mma.cu  |  5 +-
 ggml/src/ggml-cuda/gated-delta-net-mma.cuh |  3 +
 ggml/src/ggml-cuda/gated_delta_net.cu      | 64 ++++++++++++++++++----
 ggml/src/ggml-cuda/gated_delta_net.cuh     |  3 +
 ggml/src/ggml-cuda/ggml-cuda.cu            | 62 ++++++++++++++++++++-
 6 files changed, 127 insertions(+), 13 deletions(-)

diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index 6b36ca90b936da27d1593ea31f8ce681b98c98fb..fdfedb6e739682c23667747b6276d4fac30cbdbb 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -1454,6 +1454,9 @@ struct ggml_backend_cuda_context {
 
     int curr_stream_no = 0;
 
+    // GDN -> the GET_ROWS of recurrent states it reads in place, set per graph evaluation (see ggml_cuda_gdn_state_rows)
+    std::unordered_map<const ggml_tensor *, const ggml_tensor *> gdn_state_rows;
+
 #ifdef USE_CUDA_GRAPH
     // Map from first_node_ptr to cuda_graph - allows multiple graphs per context
     // when the computation is split across CPU/GPU (e.g., with --n-cpu-moe)
diff --git a/ggml/src/ggml-cuda/gated-delta-net-mma.cu b/ggml/src/ggml-cuda/gated-delta-net-mma.cu
index 0684adc1ad3dfda36aff03b423ae8807af66ad10..b6268a624a0b8924c2ed1e8f918705f2f067bc9d 100644
--- a/ggml/src/ggml-cuda/gated-delta-net-mma.cu
+++ b/ggml/src/ggml-cuda/gated-delta-net-mma.cu
@@ -141,6 +141,7 @@ static __global__ __launch_bounds__(256, BLOCKS) void gdn_single(ggml_cuda_gdn_m
     const int                                      seq   = blockIdx.x / ((D / V) * a.H);
     const int                                      v0    = slice * V;
     const int64_t                                  soff  = ((int64_t) seq * a.H + h) * D * D;
+    const int64_t                                  sin   = a.state_ids ? (int64_t) a.state_ids[seq] * a.state_row_stride + (int64_t) h * D * D : soff;
     const int64_t                                  qoff  = (seq / a.rq3) * a.sq3 + (h % a.H_k) * a.sq1;
     const int64_t                                  voff  = seq * a.sv3 + h * a.sv1 + v0;
     const int64_t                                  goff  = seq * a.sb3 + h * a.sb1;
@@ -154,7 +155,7 @@ static __global__ __launch_bounds__(256, BLOCKS) void gdn_single(ggml_cuda_gdn_m
         const int tile_index = warp + j * WARPS, r = (tile_index / (V / N)) * 16, c = (tile_index % (V / N)) * N;
 #pragma unroll
         for (int i = 0; i < acc::ne; ++i) {
-            state[j].x[i] = a.state[soff + (v0 + c + acc::get_j(i)) * D + r + acc::get_i(i)];
+            state[j].x[i] = a.state[sin + (v0 + c + acc::get_j(i)) * D + r + acc::get_i(i)];
         }
     }
     auto read_qk = [&](int64_t t, float4 & q, float4 & k) {
@@ -401,7 +402,7 @@ static gdn_path select_gdn_mma_path(int device, const ggml_cuda_gdn_mma_args & a
 #else
     // Enable only architectures benchmarked for this schedule. MMA support alone does not imply a speedup.
     if (!ampere_mma_available(info.cc) ||
-        (info.cc != GGML_CUDA_CC_AMPERE_GA10X && info.cc != GGML_CUDA_CC_ADA_LOVELACE &&
+        (info.cc != GGML_CUDA_CC_AMPERE_GA10X && info.cc != GGML_CUDA_CC_ORIN && info.cc != GGML_CUDA_CC_ADA_LOVELACE &&
          info.cc != GGML_CUDA_CC_BLACKWELL && info.cc != GGML_CUDA_CC_DGX_SPARK)) {
         return gdn_path::ar;
     }
