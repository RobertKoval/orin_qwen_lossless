+void ggml_cuda_bf16n_mul_mat_id_glu(ggml_backend_cuda_context & ctx, const ggml_tensor * gate_w, const ggml_tensor * up_w,
+        const ggml_tensor * src1, const ggml_tensor * ids, ggml_tensor * glu) {
+    int64_t ru = 0;
+    ggml_cuda_bf16n_mul_mat_id_impl(ctx, gate_w, lookup(up_w->data, ru), src1, ids, glu);
