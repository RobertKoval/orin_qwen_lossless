+// GDN whose state input is reshape(GET_ROWS(states, ids)) for a single sequence: return the GET_ROWS node so the
+// kernel can read the rows in place. Single sequence only: the state row may be the one the kernel writes back,
+// which is safe because every thread reads its slice before writing it.
+const ggml_tensor * ggml_cuda_gdn_state_rows(const ggml_tensor * gdn) {
+    static const bool off = getenv("GGML_CUDA_NO_GDN_ROWS") != nullptr;
+    if (off || gdn->op != GGML_OP_GATED_DELTA_NET || gdn->src[2]->ne[3] != 1) {
+        return nullptr;
+    }
+    const ggml_tensor * st = gdn->src[5];
+    const ggml_tensor * t  = st;
+    while (t != nullptr && (t->op == GGML_OP_RESHAPE || (t->op == GGML_OP_VIEW && t->view_offs == 0))) {
+        t = t->src[0];
+    }
+    if (t == nullptr || t->op != GGML_OP_GET_ROWS || t->type != GGML_TYPE_F32) {
+        return nullptr;
+    }
+    const ggml_tensor * src = t->src[0];
+    const ggml_tensor * ids = t->src[1];
+    if (src->type != GGML_TYPE_F32 || ids->type != GGML_TYPE_I32 || src->nb[0] != sizeof(float) ||
+        t->ne[1] != 1 || ggml_nelements(t) != ggml_nelements(st) || src->ne[0] != t->ne[0] || !ggml_is_contiguous(t)) {
+        return nullptr;
+    }
+    return t;
+}
