+        int64_t ne00, int64_t ne10, int64_t ne11, int64_t ne12,
+        uint64_t nb00, uint64_t nb01, uint64_t nb02, uint64_t nb03,
+        uint64_t nb10, uint64_t nb11, uint64_t nb12, uint64_t nb13,
+        uint64_t nb0, uint64_t nb1, uint64_t nb2, uint64_t nb3) {
+    __shared__ T tile[CUDA_CONCAT_TILE][CUDA_CONCAT_TILE + 1];
+
+    const int64_t i3 = blockIdx.z / ne12;
+    const int64_t i2 = blockIdx.z - i3 * ne12;
+    const int64_t t0 = (int64_t) blockIdx.x * CUDA_CONCAT_TILE; // position along src1 dim 0
+    const int64_t c0 = (int64_t) blockIdx.y * CUDA_CONCAT_TILE; // dim 1
+    const int tx = threadIdx.x, ty = threadIdx.y;
+
+    const char * s1 = src1 + i3*nb13 + i2*nb12;
+    char       * d  = dst  + i3*nb3  + i2*nb2;
+
+#pragma unroll
+    for (int j = ty; j < CUDA_CONCAT_TILE; j += CUDA_CONCAT_TILE_ROWS) {
+        if (t0 + j < ne10 && c0 + tx < ne11) {
+            tile[j][tx] = *(const T *) (s1 + (t0 + j)*nb10 + (c0 + tx)*nb11);
+        }
+    }
+    __syncthreads();
+#pragma unroll
+    for (int j = ty; j < CUDA_CONCAT_TILE; j += CUDA_CONCAT_TILE_ROWS) {
