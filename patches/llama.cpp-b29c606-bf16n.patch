+
+void ggml_cuda_bf16n_get_rows(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    int64_t row0 = 0;
+    const entry * e = lookup(src0->data, row0);
+    GGML_ASSERT(e && "BF16N tensor without registered aux data");
+    GGML_ASSERT(!e->cm && "GET_ROWS of a chunk-major (expert) tensor");
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && src1->type == GGML_TYPE_I32 && dst->nb[0] == sizeof(float));
+    GGML_ASSERT(src1->ne[1] == 1 && src1->ne[2] == 1 && src1->ne[3] == 1 && src0->ne[2] == 1 && src0->ne[3] == 1);
+    const int64_t n = src1->ne[0];
+    if (n == 0) {
+        return;
+    }
+    const dim3 grid((unsigned) ((n + 7) / 8));
+    cudaStream_t stream = ctx.stream();
+#define GR(CC)                                                                                                         \
+    case CC:                                                                                                           \
+        if (e->format == GGML_BF16N_NIBBLE) {                                                                          \
+            k_nibble_get_rows<CC><<<grid, 256, 0, stream>>>(nibp(*e), (const char *) src1->data, src1->nb[0], n, row0, (float *) dst->data, dst->nb[1]); \
+        } else if (e->format == GGML_BF16N_HUFPAIR) {                                                                  \
+            k_hp_get_rows<CC><<<grid, 256, 0, stream>>>(hpp(*e), e->R, (const char *) src1->data, src1->nb[0], n, row0, (float *) dst->data, dst->nb[1]); \
+        } else {                                                                                                       \
+            GGML_ABORT("bf16n: GET_ROWS not implemented for the single-symbol Huffman format");                       \
+        }                                                                                                              \
+        break;
+    switch (e->K / 512) { GR(1) GR(2) GR(4) GR(8) default: GGML_ABORT("bf16n: unsupported K"); }
+#undef GR
+    CUDA_CHECK(cudaGetLastError());
+}
+
+bool ggml_cuda_bf16n_is_registered(const ggml_tensor * t) {
+    int64_t row0;
+    return lookup(t->data, row0) != nullptr;
+}
+
+// Encode a host BF16 tensor into `tensor` (type BF16N, device memory) + registered aux, then verify by
+// decoding back on the GPU and comparing every bit with the source.
+extern "C" bool ggml_backend_cuda_bf16n_convert(struct ggml_tensor * tensor, const void * bf16_host, int format) {
+    GGML_ASSERT(tensor->type == GGML_TYPE_BF16N && ggml_is_contiguous(tensor));
+    const int64_t K = tensor->ne[0];
+    const int64_t rows = ggml_nrows(tensor);
+    GGML_ASSERT(K % 512 == 0 && K <= 4096);
+    const uint16_t * w = (const uint16_t *) bf16_host;
+
+    std::vector<uint8_t> sm(rows * K);
+    encode_sm_plane(w, rows, K, sm.data());
+    std::vector<uint8_t> aux;
+    int R = 0;
+    if (format == GGML_BF16N_HUFFMAN) {
+        const int64_t per = tensor->ne[1]; // rows per matrix (expert)
+        if (tensor->ne[2] > 1) {
+            // MoE: 8 experts per token share the GPU; the unit size only has to divide the expert
+            R = per % 16 == 0 && per >= 2048 ? 16 : per % 8 == 0 ? 8 : per % 4 == 0 ? 4 : 1;
+        } else {
+            // dense: largest unit that still gives every SM 32 warps of work (512 units)
+            R = 1;
+            for (int r = 16; r > 1; r >>= 1) {
+                if (per % r == 0 && per / r >= 512) {
+                    R = r;
+                    break;
+                }
+            }
+        }
+        // expert matrices with K > 512 get chunk-major streams for the batched (prefill) MUL_MAT_ID kernel
+        aux = encode_huffpair(w, rows, K, R, tensor->ne[2] > 1 && K > 512);
+        if (!aux.empty()) {
+            format = GGML_BF16N_HUFPAIR;
+        } else {
+            aux = encode_huffman(w, rows, K, R); // more distinct exponent pairs than the pair LUT holds
+        }
+    } else {
+        aux = encode_nibble(w, rows, K);
+        // escaped weights must read as +0 in the plane so the dense path adds exactly nothing for them
+        const aux_header * h = (const aux_header *) aux.data();
+        const uint32_t * esc = (const uint32_t *) (aux.data() + h->off_d);
+        const uint32_t * eo = (const uint32_t *) (aux.data() + h->off_c);
+        for (int64_t r = 0; r < rows; r++) {
+            for (uint32_t i = eo[r]; i < eo[r + 1]; i++) {
+                const int col = esc[i] & 0xFFF;
+                const int c = col / 512, p = col % 512;
+                const int j = p / 128, l = (p % 128) / 4, t = p % 4;
+                sm[r * K + c * 512 + 16 * l + 4 * j + t] = 0;
+            }
+        }
+    }
+    if (format == GGML_BF16N_HUFPAIR && (((const aux_header *) aux.data())->flags & 1)) {
+        // chunk-major units also store their plane chunk-major ([chunk][row][512 B] inside each unit), so a kernel
+        // walking chunk c over the unit's rows reads one contiguous block
+        std::vector<uint8_t> tmp(R * K);
+        for (int64_t u = 0; u < rows / R; u++) {
+            uint8_t * ub = sm.data() + u * R * K;
+            memcpy(tmp.data(), ub, R * K);
+            for (int r = 0; r < R; r++) {
+                for (int64_t c = 0; c < K / 512; c++) {
+                    memcpy(ub + (c * R + r) * 512, tmp.data() + r * K + c * 512, 512);
+                }
+            }
+        }
+    }
+    CUDA_CHECK(cudaMemcpy(tensor->data, sm.data(), sm.size(), cudaMemcpyHostToDevice));
+    void * aux_dev = nullptr;
+    CUDA_CHECK(cudaMalloc(&aux_dev, aux.size()));
+    CUDA_CHECK(cudaMemcpy(aux_dev, aux.data(), aux.size(), cudaMemcpyHostToDevice));
+
+    entry e;
+    e.base = (const uint8_t *) tensor->data; e.nbytes = sm.size(); e.format = format; e.K = K; e.rows = rows; e.R = R;
+    e.aux = aux_dev; e.aux_bytes = aux.size();
+    e.cm = format == GGML_BF16N_HUFPAIR && (((const aux_header *) aux.data())->flags & 1);
+    const aux_header * h = (const aux_header *) aux.data();
+    const uint8_t * a = (const uint8_t *) aux_dev;
+    if (format == GGML_BF16N_HUFPAIR) {
+        e.hlut = (const uint32_t *) (a + h->off_a);
+        e.lane_off = (const uint32_t *) (a + h->off_b);
+        e.lane_rel = (const uint16_t *) (a + h->off_c);
+        e.stream = (const uint32_t *) (a + h->off_d);
+    } else if (format == GGML_BF16N_HUFFMAN) {
+        e.hlut = (const uint32_t *) (a + h->off_a);
+        e.lane_off = (const uint32_t *) (a + h->off_b);
+        e.stream = (const uint32_t *) (a + h->off_c);
+    } else {
+        e.nib = a + h->off_a;
+        e.lut_row = (const uint4 *) (a + h->off_b);
+        e.esc_off = (const uint32_t *) (a + h->off_c);
+        e.esc = (const uint32_t *) (a + h->off_d);
+    }
+    {
+        std::lock_guard<std::mutex> lk(g_mutex);
+        auto it = std::upper_bound(g_entries.begin(), g_entries.end(), e.base, [](const uint8_t * b, const entry & x) { return b < x.base; });
+        g_entries.insert(it, e);
+    }
+
+    // bitwise round-trip check on the GPU, in chunks bounded to 64 MiB of BF16
+    bool ok = true;
+    {
+        const int64_t chunk_rows = std::max<int64_t>((64ll << 20) / (K * 2) / std::max(R, 1) * std::max(R, 1), std::max(R, 1));
+        uint16_t * d_out = nullptr;
+        CUDA_CHECK(cudaMalloc(&d_out, chunk_rows * K * 2));
+        std::vector<uint16_t> back(chunk_rows * K);
+        ggml_tensor view = *tensor;
+        for (int64_t r0 = 0; r0 < rows && ok; r0 += chunk_rows) {
+            const int64_t nr = std::min(chunk_rows, rows - r0);
+            view.data = (char *) tensor->data + r0 * K;
+            view.ne[1] = nr; view.ne[2] = 1; view.ne[3] = 1;
+            view.nb[2] = view.nb[1] * nr; view.nb[3] = view.nb[2];
+            int64_t vr0;
+            const entry * ve = lookup(view.data, vr0);
+            launch_dequant(*ve, vr0, nr, d_out, 0);
+            CUDA_CHECK(cudaGetLastError());
+            CUDA_CHECK(cudaMemcpy(back.data(), d_out, nr * K * 2, cudaMemcpyDeviceToHost));
+            ok = memcmp(back.data(), w + r0 * K, nr * K * 2) == 0;
+        }
+        CUDA_CHECK(cudaFree(d_out));
+    }
+    const double ratio = (double) (sm.size() + aux.size()) / (double) (rows * K * 2);
+    fprintf(stderr, "bf16n: %-32s %s K=%5lld rows=%7lld R=%2d ratio=%.4f roundtrip=%s\n", tensor->name,
+        format == GGML_BF16N_HUFPAIR ? "hufpair" : format == GGML_BF16N_HUFFMAN ? "huffman" : "nibble ", (long long) K, (long long) rows, R, ratio, ok ? "OK" : "FAIL");
+    return ok;
+}
