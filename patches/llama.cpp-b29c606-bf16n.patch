+// LLAMA_BF16N=hybrid|huffman|nibble: keep BF16 weights resident in lossless compressed form (GGML_TYPE_BF16N).
+// hybrid: routed experts use the Huffman exponent format (max compression), dense weights the nibble format (fast).
+static int llama_bf16n_format_for(const ggml_tensor & t, ggml_backend_buffer_type_t buft) {
+    static const char * mode = getenv("LLAMA_BF16N");
+    if (mode == nullptr || *mode == 0 || strcmp(mode, "0") == 0) {
+        return 0;
+    }
+    const std::string name = ggml_get_name(&t);
+    // the router is stored as F32 but holds BF16 values (exactness is checked at load)
+    const bool router = t.type == GGML_TYPE_F32 && name.size() > 19 && name.compare(name.size() - 19, 19, "ffn_gate_inp.weight") == 0;
+    if ((t.type != GGML_TYPE_BF16 && !router) || ggml_n_dims(&t) < 2 || t.ne[0] % 512 != 0 || t.ne[0] > 4096) {
+        return 0;
+    }
+    if (ggml_backend_buft_is_host(buft)) {
+        return 0;
+    }
+    if (strcmp(mode, "huffman") == 0) {
+        return 2;
+    }
+    if (strcmp(mode, "nibble") == 0) {
+        return 1;
+    }
+    // hybrid: entropy-coded where the matrices are big enough to keep every SM busy, fixed-width nibbles for the small ones
+    static const int64_t dense_min = getenv("LLAMA_BF16N_DENSE_MIN") ? atoll(getenv("LLAMA_BF16N_DENSE_MIN")) : (8ll << 20);
+    const bool expert = name.find("_exps") != std::string::npos;
+    return expert || ggml_nelements(&t) >= dense_min ? 2 : 1;
