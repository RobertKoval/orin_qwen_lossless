+// GGML_TYPE_BF16N: lossless BF16 weights resident in compressed form.
+//
+// The ggml tensor holds the sign|mantissa byte plane (1 B/weight, 512-weight chunks, lane-major:
+// lane l owns positions 128*j + 4*l + t, stored at bytes 16*l + 4*j + t of the chunk).
+// The exponent lives in a device-side aux buffer registered per tensor, in one of two formats:
+//   NIBBLE : 4-bit code per weight into a per-row 16-entry exponent LUT (entry 0 = exponent 0);
+//            weights whose exponent is not in the LUT decode to +0 and are added back from an escape list.
+//   HUFFMAN: per-tensor length-limited canonical Huffman code; each warp owns R consecutive rows and
+//            each lane decodes its own bitstream (lane offsets per unit). No escapes.
+// Every BF16 bit pattern is reconstructed exactly; products are FP32 FMAs of the exact weights.
+
+#include "bf16n.cuh"
+#include "unary.cuh"
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstring>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace {
+
+constexpr uint32_t BF16N_MAGIC = 0x4e363142; // "B16N"
+constexpr int HUF_LMAX  = 10;
+constexpr int HUF_GROUP = 32 / HUF_LMAX;
+constexpr int HP_LP     = 12;   // exponent-pair code length limit: two pair codes fit the guaranteed 32-bit window
+constexpr int HP_PF     = 4;    // per-lane stream prefetch depth (words)
+constexpr int HP_NT     = 1024; // one block per SM: one LUT copy, the rest of L1 for the lane streams
+
+struct aux_header {
+    uint32_t magic, format, K, R;
+    uint64_t rows;
+    uint64_t off_a, off_b, off_c, off_d; // format specific array offsets (bytes from aux start)
+    uint64_t n_a, n_b;                   // escapes (nibble) / units, stream words (huffman)
+};
+
+struct entry {
+    const uint8_t * base = nullptr;
+    size_t          nbytes = 0;
+    int             format = 0;
+    int64_t         K = 0, rows = 0;
+    int             R = 0;
+    void *          aux = nullptr;
+    size_t          aux_bytes = 0;
+    // nibble
+    const uint8_t  * nib     = nullptr;
+    const uint4    * lut_row = nullptr;
+    const uint32_t * esc_off = nullptr;
+    const uint32_t * esc     = nullptr;
+    // huffman
+    const uint32_t * hlut     = nullptr;
+    const uint32_t * lane_off = nullptr;
+    const uint32_t * stream   = nullptr;
+    // huffman pairs
+    const uint16_t * lane_rel = nullptr; // with lane_off = per-unit base
+};
+
+std::mutex         g_mutex;
+std::vector<entry> g_entries; // sorted by base
+
+const entry * lookup(const void * p, int64_t & row0) {
+    const uint8_t * q = (const uint8_t *) p;
+    auto it = std::upper_bound(g_entries.begin(), g_entries.end(), q, [](const uint8_t * a, const entry & e) { return a < e.base; });
+    if (it == g_entries.begin()) {
+        return nullptr;
+    }
+    --it;
+    if (q >= it->base + it->nbytes) {
+        return nullptr;
+    }
+    const size_t off = q - it->base;
+    GGML_ASSERT(off % it->K == 0);
+    row0 = off / it->K;
+    return &*it;
+}
+
+inline int pos_of(int l, int s) { return 128 * (s >> 2) + 4 * l + (s & 3); }
+
+template <typename F>
+void parallel_for(int64_t n, F && f) {
+    const int nt = std::max(1u, std::min(12u, std::thread::hardware_concurrency()));
+    std::atomic<int64_t> next{0};
+    std::vector<std::thread> th;
+    for (int t = 0; t < nt; t++) {
+        th.emplace_back([&]() {
+            for (;;) {
+                const int64_t i = next.fetch_add(1);
+                if (i >= n) {
+                    break;
+                }
+                f(i);
+            }
+        });
+    }
+    for (auto & t : th) {
+        t.join();
+    }
+}
+
+// ---------------------------------------------------------------- host encoders
+
+void encode_sm_plane(const uint16_t * w, int64_t rows, int64_t K, uint8_t * sm) {
+    const int64_t C = K / 512;
+    parallel_for(rows, [&](int64_t r) {
+        for (int64_t c = 0; c < C; c++) {
+            const uint16_t * src = w + r * K + c * 512;
+            uint8_t * dst = sm + r * K + c * 512;
+            for (int l = 0; l < 32; l++) {
+                for (int s = 0; s < 16; s++) {
+                    const uint16_t v = src[pos_of(l, s)];
+                    dst[16 * l + s] = (uint8_t) (((v >> 15) << 7) | (v & 0x7F));
+                }
+            }
+        }
+    });
+}
+
+std::vector<uint8_t> encode_nibble(const uint16_t * w, int64_t rows, int64_t K) {
+    const int64_t C = K / 512;
+    std::vector<uint8_t> nib(rows * K / 2);
+    std::vector<uint8_t> lut(rows * 16, 0);
+    constexpr int64_t BLK = 256;
+    const int64_t nblk = (rows + BLK - 1) / BLK;
+    std::vector<std::vector<uint32_t>> esc_blk(nblk);
+    std::vector<uint32_t> cnt(rows);
+    parallel_for(nblk, [&](int64_t b) {
+        for (int64_t r = b * BLK; r < std::min(rows, (b + 1) * BLK); r++) {
+            const uint16_t * row = w + r * K;
+            int hist[256] = {0};
+            for (int64_t k = 0; k < K; k++) {
+                hist[(row[k] >> 7) & 0xFF]++;
+            }
+            int idx[256];
+            for (int i = 0; i < 256; i++) {
+                idx[i] = i;
+            }
+            std::sort(idx, idx + 256, [&](int a, int c) { return hist[a] > hist[c] || (hist[a] == hist[c] && a < c); });
+            int code_of[256];
+            for (int i = 0; i < 256; i++) {
+                code_of[i] = -1;
+            }
+            code_of[0] = 0;
+            uint8_t * L = &lut[r * 16];
+            int n = 1;
+            for (int i = 0; i < 256 && n < 16; i++) {
+                const int x = idx[i];
+                if (hist[x] == 0) {
+                    break;
+                }
+                if (x == 0 || x >= 128) {
+                    continue; // msb-set exponents cannot go through the prmt LUT
+                }
+                L[n] = (uint8_t) x;
+                code_of[x] = n++;
+            }
+            uint32_t ne = 0;
+            for (int64_t c = 0; c < C; c++) {
+                uint8_t * nb = &nib[(r * C + c) * 256];
+                for (int l = 0; l < 32; l++) {
+                    uint32_t nw[2] = {0, 0};
+                    for (int s = 0; s < 16; s++) {
+                        const int col = (int) (c * 512 + pos_of(l, s));
+                        const uint16_t v = row[col];
+                        const int ex = (v >> 7) & 0xFF;
+                        int code = code_of[ex];
+                        if (code < 0) {
+                            const uint32_t smb = ((v >> 15) << 7) | (v & 0x7F);
+                            esc_blk[b].push_back((uint32_t) col | (smb << 12) | ((uint32_t) ex << 20));
+                            ne++;
+                            code = 0;
+                        }
+                        nw[s >> 3] |= (uint32_t) code << (4 * (s & 7));
+                    }
+                    memcpy(nb + 8 * l, nw, 8);
+                }
+            }
+            cnt[r] = ne;
+        }
+    });
+    // escape slots must also read as +0 in the sign|mantissa plane: done by the caller (zero_escapes)
+    std::vector<uint32_t> esc_off(rows + 1, 0);
+    for (int64_t r = 0; r < rows; r++) {
+        esc_off[r + 1] = esc_off[r] + cnt[r];
+    }
+    const uint64_t n_esc = esc_off[rows];
+    aux_header h = {};
+    h.magic = BF16N_MAGIC; h.format = GGML_BF16N_NIBBLE; h.K = (uint32_t) K; h.rows = rows;
+    h.off_a = 256;                                      // nibble plane
+    h.off_b = h.off_a + nib.size();                     // per-row LUT
+    h.off_c = h.off_b + lut.size();                     // esc_off
+    h.off_d = h.off_c + esc_off.size() * 4;             // escapes
+    h.n_a = n_esc;
+    std::vector<uint8_t> aux(h.off_d + std::max<uint64_t>(n_esc, 1) * 4, 0);
+    memcpy(aux.data(), &h, sizeof(h));
+    memcpy(aux.data() + h.off_a, nib.data(), nib.size());
+    memcpy(aux.data() + h.off_b, lut.data(), lut.size());
+    memcpy(aux.data() + h.off_c, esc_off.data(), esc_off.size() * 4);
+    uint8_t * e = aux.data() + h.off_d;
+    for (auto & v : esc_blk) {
+        memcpy(e, v.data(), v.size() * 4);
+        e += v.size() * 4;
+    }
+    return aux;
+}
+
+std::vector<int> limited_lengths(const std::vector<uint64_t> & freq, int L) {
+    std::vector<int> syms;
+    for (int i = 0; i < (int) freq.size(); i++) {
+        if (freq[i]) {
+            syms.push_back(i);
+        }
+    }
+    std::vector<int> len(freq.size(), 0);
+    if (syms.size() == 1) {
+        len[syms[0]] = 1;
+        return len;
+    }
+    struct item { uint64_t w; std::vector<int> s; };
+    std::vector<item> leaves;
+    for (int s : syms) {
+        leaves.push_back({freq[s], {s}});
+    }
+    std::sort(leaves.begin(), leaves.end(), [](const item & a, const item & b) { return a.w < b.w; });
+    std::vector<item> cur = leaves;
+    for (int d = 1; d < L; d++) {
+        std::vector<item> pk;
+        for (size_t i = 0; i + 1 < cur.size(); i += 2) {
+            item m{cur[i].w + cur[i + 1].w, cur[i].s};
+            m.s.insert(m.s.end(), cur[i + 1].s.begin(), cur[i + 1].s.end());
+            pk.push_back(std::move(m));
+        }
+        std::vector<item> mg;
+        std::merge(pk.begin(), pk.end(), leaves.begin(), leaves.end(), std::back_inserter(mg), [](const item & a, const item & b) { return a.w < b.w; });
+        cur = std::move(mg);
+    }
+    for (size_t i = 0; i < 2 * syms.size() - 2; i++) {
+        for (int s : cur[i].s) {
+            len[s]++;
+        }
+    }
+    return len;
+}
+
+std::vector<uint8_t> encode_huffman(const uint16_t * w, int64_t rows, int64_t K, int R) {
+    const int64_t C = K / 512;
+    const int64_t units = rows / R;
+    std::vector<uint64_t> freq(256, 0);
+    {
+        std::mutex m;
+        constexpr int64_t BLK = 1024;
+        parallel_for((rows + BLK - 1) / BLK, [&](int64_t b) {
+            uint64_t h[256] = {0};
+            for (int64_t i = b * BLK * K; i < std::min(rows, (b + 1) * BLK) * K; i++) {
+                h[(w[i] >> 7) & 0xFF]++;
+            }
+            std::lock_guard<std::mutex> lk(m);
+            for (int i = 0; i < 256; i++) {
+                freq[i] += h[i];
+            }
+        });
+    }
+    const std::vector<int> len = limited_lengths(freq, HUF_LMAX);
+    std::vector<uint32_t> code(256, 0);
+    {
+        uint32_t c = 0;
+        for (int l = 1; l <= HUF_LMAX; l++) {
+            for (int s = 0; s < 256; s++) {
+                if (len[s] == l) {
+                    code[s] = c++;
+                }
+            }
+            c <<= 1;
+        }
+    }
+    std::vector<uint32_t> lut(1 << HUF_LMAX, 0);
+    for (int s = 0; s < 256; s++) {
+        if (len[s]) {
+            const uint32_t lo = code[s] << (HUF_LMAX - len[s]), hi = (code[s] + 1) << (HUF_LMAX - len[s]);
+            for (uint32_t i = lo; i < hi; i++) {
+                lut[i] = (uint32_t) len[s] | ((uint32_t) s << 7);
+            }
+        }
+    }
+    std::vector<std::vector<uint32_t>> ustream(units);
+    std::vector<uint32_t> lane_rel(units * 32);
+    parallel_for(units, [&](int64_t u) {
+        auto & out = ustream[u];
+        for (int l = 0; l < 32; l++) {
+            lane_rel[u * 32 + l] = (uint32_t) out.size();
+            uint64_t acc = 0;
+            int nb = 0;
+            for (int64_t r = u * R; r < (u + 1) * R; r++) {
+                for (int64_t c = 0; c < C; c++) {
+                    for (int s = 0; s < 16; s++) {
+                        const int e = (w[r * K + c * 512 + pos_of(l, s)] >> 7) & 0xFF;
+                        acc = (acc << len[e]) | code[e];
+                        nb += len[e];
+                        if (nb >= 32) {
+                            out.push_back((uint32_t) (acc >> (nb - 32)));
+                            nb -= 32;
+                            acc &= nb ? ((1ull << nb) - 1) : 0;
+                        }
+                    }
+                }
+            }
+            if (nb) {
+                out.push_back((uint32_t) (acc << (32 - nb)));
+            }
+        }
+    });
+    std::vector<uint32_t> lane_off(units * 32);
+    uint64_t n_words = 0;
+    for (int64_t u = 0; u < units; u++) {
+        for (int l = 0; l < 32; l++) {
+            lane_off[u * 32 + l] = (uint32_t) (n_words + lane_rel[u * 32 + l]);
+        }
+        n_words += ustream[u].size();
+    }
+    GGML_ASSERT(n_words + 16 < (1ull << 32));
+    aux_header h = {};
+    h.magic = BF16N_MAGIC; h.format = GGML_BF16N_HUFFMAN; h.K = (uint32_t) K; h.R = (uint32_t) R; h.rows = rows;
+    h.off_a = 256;                                   // LUT
+    h.off_b = h.off_a + lut.size() * 4;              // lane offsets
+    h.off_c = h.off_b + lane_off.size() * 4;         // stream
+    h.n_a = units; h.n_b = n_words;
+    std::vector<uint8_t> aux(h.off_c + (n_words + 16) * 4, 0); // +16 words: decoder lookahead
+    memcpy(aux.data(), &h, sizeof(h));
+    memcpy(aux.data() + h.off_a, lut.data(), lut.size() * 4);
+    memcpy(aux.data() + h.off_b, lane_off.data(), lane_off.size() * 4);
+    uint8_t * p = aux.data() + h.off_c;
+    for (auto & v : ustream) {
+        memcpy(p, v.data(), v.size() * 4);
+        p += v.size() * 4;
+    }
+    return aux;
+}
+
+// Huffman over exponent PAIRS (positions t,t+1 of a lane slot group): adjacent exponents are strongly
+// correlated (pair entropy ~2.05 vs ~2.53 bit/weight). Returns empty if the tensor has > 2^HP_LP distinct pairs.
+std::vector<uint8_t> encode_huffpair(const uint16_t * w, int64_t rows, int64_t K, int R) {
+    const int64_t C = K / 512;
+    const int64_t units = rows / R;
+    auto ex = [&](int64_t i) { return (w[i] >> 7) & 0xFF; };
+    std::vector<uint64_t> freq(65536, 0);
+    {
+        std::mutex m;
+        constexpr int64_t BLK = 1024;
+        parallel_for((rows + BLK - 1) / BLK, [&](int64_t b) {
+            std::vector<uint64_t> h(65536, 0);
+            for (int64_t i = b * BLK * K; i < std::min(rows, (b + 1) * BLK) * K; i += 2) {
+                h[ex(i) | ex(i + 1) << 8]++;
+            }
+            std::lock_guard<std::mutex> lk(m);
+            for (int i = 0; i < 65536; i++) {
+                freq[i] += h[i];
+            }
+        });
+    }
+    int nsym = 0;
+    for (auto f : freq) {
+        nsym += f != 0;
+    }
+    if (nsym > (1 << HP_LP)) {
+        return {};
+    }
+    const std::vector<int> len = limited_lengths(freq, HP_LP);
+    std::vector<uint32_t> code(65536, 0);
+    {
+        uint32_t c = 0;
+        for (int l = 1; l <= HP_LP; l++) {
+            for (int s = 0; s < 65536; s++) {
+                if (len[s] == l) {
+                    code[s] = c++;
+                }
+            }
+            c <<= 1;
+        }
+    }
+    std::vector<uint32_t> lut(1 << HP_LP, 0);
+    for (int s = 0; s < 65536; s++) {
+        if (len[s]) {
+            const uint32_t lo = code[s] << (HP_LP - len[s]), hi = (code[s] + 1) << (HP_LP - len[s]);
+            for (uint32_t i = lo; i < hi; i++) {
+                lut[i] = ((uint32_t) (s >> 8) << 23) | ((uint32_t) (s & 0xFF) << 7) | (uint32_t) len[s];
+            }
+        }
+    }
+    std::vector<std::vector<uint32_t>> ustream(units);
+    std::vector<uint32_t> rel32(units * 32);
+    parallel_for(units, [&](int64_t u) {
+        auto & out = ustream[u];
+        for (int l = 0; l < 32; l++) {
+            rel32[u * 32 + l] = (uint32_t) out.size();
+            uint64_t acc = 0;
+            int nb = 0;
+            for (int64_t r = u * R; r < (u + 1) * R; r++) {
+                for (int64_t c = 0; c < C; c++) {
+                    for (int s = 0; s < 16; s += 2) {
+                        const int64_t i = r * K + c * 512 + pos_of(l, s);
+                        const int sym = ex(i) | ex(i + 1) << 8;
+                        acc = (acc << len[sym]) | code[sym];
+                        nb += len[sym];
+                        if (nb >= 32) {
+                            out.push_back((uint32_t) (acc >> (nb - 32)));
+                            nb -= 32;
+                            acc &= nb ? ((1ull << nb) - 1) : 0;
+                        }
+                    }
+                }
+            }
+            if (nb) {
+                out.push_back((uint32_t) (acc << (32 - nb)));
+            }
+        }
+    });
+    std::vector<uint32_t> unit_base(units);
+    std::vector<uint16_t> lane_rel(units * 32);
+    uint64_t n_words = 0;
+    for (int64_t u = 0; u < units; u++) {
+        unit_base[u] = (uint32_t) n_words;
+        for (int l = 0; l < 32; l++) {
+            GGML_ASSERT(rel32[u * 32 + l] <= 0xFFFF);
+            lane_rel[u * 32 + l] = (uint16_t) rel32[u * 32 + l];
+        }
+        n_words += ustream[u].size();
+    }
+    GGML_ASSERT(n_words + 16 < (1ull << 32));
+    aux_header h = {};
+    h.magic = BF16N_MAGIC; h.format = GGML_BF16N_HUFPAIR; h.K = (uint32_t) K; h.R = (uint32_t) R; h.rows = rows;
+    h.off_a = 256;                                    // LUT
+    h.off_b = h.off_a + lut.size() * 4;               // unit base (u32)
+    h.off_c = h.off_b + unit_base.size() * 4;         // lane offsets relative to unit base (u16)
+    h.off_d = (h.off_c + lane_rel.size() * 2 + 15) & ~15ull; // stream
+    h.n_a = units; h.n_b = n_words;
+    std::vector<uint8_t> aux(h.off_d + (n_words + 16) * 4, 0); // +16 words: prefetch lookahead
+    memcpy(aux.data(), &h, sizeof(h));
+    memcpy(aux.data() + h.off_a, lut.data(), lut.size() * 4);
+    memcpy(aux.data() + h.off_b, unit_base.data(), unit_base.size() * 4);
+    memcpy(aux.data() + h.off_c, lane_rel.data(), lane_rel.size() * 2);
+    uint8_t * p = aux.data() + h.off_d;
+    for (auto & v : ustream) {
+        memcpy(p, v.data(), v.size() * 4);
+        p += v.size() * 4;
+    }
+    return aux;
+}
+
+// ---------------------------------------------------------------- device side
+
+__device__ __forceinline__ uint32_t prmt(uint32_t a, uint32_t b, uint32_t sel) {
+    uint32_t d;
+    asm("prmt.b32 %0, %1, %2, %3;" : "=r"(d) : "r"(a), "r"(b), "r"(sel));
+    return d;
+}
+
+__device__ __forceinline__ uint32_t sel_bits(uint32_t a, uint32_t b) { // (a & 0x807F807F) | (b & ~0x807F807F)
+    uint32_t d;
+    asm("lop3.b32 %0, %1, %2, 0x807F807F, 0xE4;" : "=r"(d) : "r"(a), "r"(b));
+    return d;
+}
+
+// column = one output vector: (token) for MUL_MAT, (token, expert slot) for MUL_MAT_ID
+struct cols_t {
+    const char * x; char * dst;
+    int64_t x_tok, x_slot, dst_tok, dst_slot; // byte strides
+    const char * ids; int64_t ids_s0, ids_s1; int n_used, ne11;
+    int64_t rows_per_matrix, row0, nrows;
+};
+
+__device__ __forceinline__ void col_setup(const cols_t & p, int col, const float *& x, float *& dst, int64_t & rbase) {
+    if (p.ids) {
+        const int t = col / p.n_used, i = col % p.n_used;
+        const int e = *(const int32_t *) (p.ids + t * p.ids_s1 + i * p.ids_s0);
+        x = (const float *) (p.x + t * p.x_tok + (i % p.ne11) * p.x_slot);
+        dst = (float *) (p.dst + t * p.dst_tok + i * p.dst_slot);
+        rbase = p.row0 + (int64_t) e * p.rows_per_matrix;
+    } else {
+        x = (const float *) (p.x + col * p.x_tok);
+        dst = (float *) (p.dst + col * p.dst_tok);
+        rbase = p.row0;
+    }
+}
+
+__device__ __forceinline__ float warp_sum(float v) {
+#pragma unroll
+    for (int o = 16; o; o >>= 1) {
+        v += __shfl_xor_sync(0xffffffffu, v, o);
+    }
+    return v;
+}
+
+struct nib_ptrs { const uint8_t * sm; const uint8_t * nib; const uint4 * lut_row; const uint32_t * esc_off; const uint32_t * esc; };
+struct huf_ptrs { const uint8_t * sm; const uint32_t * lut; const uint32_t * lane_off; const uint32_t * stream; };
+
+// one row of the nibble format held in registers: loads are issued before any of them is used
+template <int C>
+struct nib_row {
+    uint4 smv[C];
+    uint2 nbv[C];
+    uint4 L;
+};
+
+template <int C>
+__device__ __forceinline__ void nib_row_load(nib_row<C> & d, const nib_ptrs & w, int64_t gr, int lane) {
+    constexpr int K = C * 512;
+    const uint8_t * sp = w.sm + gr * K;
+    const uint8_t * np = w.nib + gr * (K / 2);
+#pragma unroll
+    for (int c = 0; c < C; c++) {
+        d.smv[c] = __ldg((const uint4 *) (sp + c * 512) + lane);
+        d.nbv[c] = __ldg((const uint2 *) (np + c * 256) + lane);
+    }
+    d.L = __ldg(w.lut_row + gr);
+}
+
+// dot(row gr, x) for the nibble format; x read through L1 (no shared staging); result in every lane
+template <int C>
+__device__ __forceinline__ float nib_row_dot(const nib_row<C> & d, const nib_ptrs & w, int64_t gr, const float * __restrict__ x, int lane) {
+    const uint4 * smv = d.smv;
+    const uint2 * nbv = d.nbv;
+    const uint4 L = d.L;
+    float a0 = 0.f, a1 = 0.f, a2 = 0.f, a3 = 0.f;
+#pragma unroll
+    for (int c = 0; c < C; c++) {
+        const uint32_t smw[4] = {smv[c].x, smv[c].y, smv[c].z, smv[c].w};
+        const uint32_t nw[2] = {nbv[c].x, nbv[c].y};
+#pragma unroll
+        for (int j = 0; j < 4; j++) {
+            const float4 xv = __ldg((const float4 *) (x + c * 512 + 128 * j + 4 * lane));
+            const uint32_t sel = (j & 1) ? (nw[j >> 1] >> 16) : nw[j >> 1];
+            const uint32_t E4 = prmt(L.x, L.y, sel) | prmt(L.z, L.w, sel ^ 0x8888u);
+            const uint32_t w0 = (prmt(smw[j], 0, 0x9180u) & 0x807F807Fu) | (prmt(E4, 0, 0x4140u) << 7);
+            const uint32_t w1 = (prmt(smw[j], 0, 0xB3A2u) & 0x807F807Fu) | (prmt(E4, 0, 0x4342u) << 7);
+            a0 = fmaf(__uint_as_float(w0 << 16), xv.x, a0);
+            a1 = fmaf(__uint_as_float(w0 & 0xFFFF0000u), xv.y, a1);
+            a2 = fmaf(__uint_as_float(w1 << 16), xv.z, a2);
+            a3 = fmaf(__uint_as_float(w1 & 0xFFFF0000u), xv.w, a3);
+        }
+    }
+    float acc = (a0 + a1) + (a2 + a3);
+    const uint32_t e_beg = w.esc_off[gr], e_end = w.esc_off[gr + 1];
+    for (uint32_t i = e_beg + lane; i < e_end; i += 32) {
+        const uint32_t rec = w.esc[i];
+        const uint32_t smb = (rec >> 12) & 0xFF, ex = rec >> 20;
+        const uint32_t bits = ((smb & 0x80) << 8) | (ex << 7) | (smb & 0x7F);
+        acc = fmaf(__uint_as_float(bits << 16), __ldg(x + (rec & 0xFFF)), acc);
+    }
+    return warp_sum(acc);
+}
+
+struct huf_state {
+    const uint32_t * sp;
+    uint32_t hi, lo, nw0, nw1, acc, acc_chk;
+    int nbits;
+};
+
+__device__ __forceinline__ void huf_init(huf_state & st, const huf_ptrs & w, int64_t gu, int lane) {
+    st.sp = w.stream + w.lane_off[gu * 32 + lane];
+    st.hi = __ldg(st.sp); st.lo = __ldg(st.sp + 1);
+    st.nw0 = __ldg(st.sp + 2); st.nw1 = __ldg(st.sp + 3);
+    st.sp += 4;
+    st.nbits = 64; st.acc = 0; st.acc_chk = 0;
+}
+
+// decode the next row of the warp's unit and return dot(row, x); x and lut in shared memory
+template <int C>
+__device__ __forceinline__ float huf_row_dot(huf_state & st, const uint8_t * __restrict__ sm, const uint32_t * lut,
+        int64_t gr, const float * xs, int lane) {
+    constexpr int K = C * 512;
+    const uint8_t * rp = sm + gr * K;
+    uint4 smv[C];
+#pragma unroll
+    for (int c = 0; c < C; c++) {
+        smv[c] = __ldg((const uint4 *) (rp + c * 512) + lane);
+    }
+    float a0 = 0.f, a1 = 0.f, a2 = 0.f, a3 = 0.f;
+#pragma unroll
+    for (int c = 0; c < C; c++) {
+        const uint32_t smw[4] = {smv[c].x, smv[c].y, smv[c].z, smv[c].w};
+        uint32_t ex[16];
+#pragma unroll
+        for (int s = 0; s < 16; s++) {
+            if (s % HUF_GROUP == 0) {
+                st.nbits -= (int) ((st.acc - st.acc_chk) & 127u);
+                st.acc_chk = st.acc;
+                if (st.nbits <= 32) {
+                    const uint32_t sh = 32 - st.nbits;
+                    st.hi |= __funnelshift_lc(st.nw0, 0u, sh);
+                    st.lo |= __funnelshift_lc(0u, st.nw0, sh);
+                    st.nbits += 32;
+                    st.nw0 = st.nw1;
+                    st.nw1 = __ldg(st.sp);
+                    st.sp++;
+                }
+            }
+            const uint32_t ent = lut[__umulhi(st.hi, 1u << HUF_LMAX)];
+            st.hi = __funnelshift_l(st.lo, st.hi, ent);
+            st.lo = __funnelshift_l(0u, st.lo, ent);
+            st.acc += ent;
+            ex[s] = ent;
+        }
+#pragma unroll
+        for (int j = 0; j < 4; j++) {
+            const float4 xv = *(const float4 *) (xs + c * 512 + 128 * j + 4 * lane);
+            const uint32_t w0 = sel_bits(prmt(smw[j], 0, 0x9180u), prmt(ex[4 * j], ex[4 * j + 1], 0x5410u));
+            const uint32_t w1 = sel_bits(prmt(smw[j], 0, 0xB3A2u), prmt(ex[4 * j + 2], ex[4 * j + 3], 0x5410u));
+            a0 = fmaf(__uint_as_float(w0 << 16), xv.x, a0);
+            a1 = fmaf(__uint_as_float(w0 & 0xFFFF0000u), xv.y, a1);
+            a2 = fmaf(__uint_as_float(w1 << 16), xv.z, a2);
+            a3 = fmaf(__uint_as_float(w1 & 0xFFFF0000u), xv.w, a3);
+        }
+    }
+    return warp_sum((a0 + a1) + (a2 + a3));
+}
+
+template <int C>
+__global__ void __launch_bounds__(256) k_nibble_mmv(const nib_ptrs w, cols_t p) {
+    const float * xg; float * out; int64_t rbase;
+    col_setup(p, blockIdx.y, xg, out, rbase);
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    for (int64_t r = blockIdx.x * 8 + warp; r < p.nrows; r += gridDim.x * 8) {
+        nib_row<C> d;
+        nib_row_load<C>(d, w, rbase + r, lane);
+        const float v = nib_row_dot<C>(d, w, rbase + r, xg, lane);
+        if (lane == 0) {
+            out[r] = v;
+        }
+    }
+}
+
+// out = up(x) * silu(gate(x)), bitwise the same as MUL_MAT, MUL_MAT, GLU(SWIGLU)
+template <int C>
+__global__ void __launch_bounds__(256) k_nibble_mmv_glu(const nib_ptrs g, const nib_ptrs u, cols_t p) {
+    const float * xg; float * out; int64_t rbase;
+    col_setup(p, blockIdx.y, xg, out, rbase);
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    for (int64_t r = blockIdx.x * 8 + warp; r < p.nrows; r += gridDim.x * 8) {
+        nib_row<C> dg, du;
+        nib_row_load<C>(dg, g, rbase + r, lane); // both rows in flight before either is decoded
+        nib_row_load<C>(du, u, rbase + r, lane);
+        const float gv = nib_row_dot<C>(dg, g, rbase + r, xg, lane);
+        const float uv = nib_row_dot<C>(du, u, rbase + r, xg, lane);
+        if (lane == 0) {
+            out[r] = uv * ggml_cuda_op_silu_single(gv);
+        }
+    }
+}
+
+template <int C>
+__device__ __forceinline__ void stage(float * xs, uint32_t * lut, const float * xg, const uint32_t * lut_g) {
+    for (int i = threadIdx.x; i < C * 512; i += blockDim.x) {
+        xs[i] = xg[i];
+    }
+    for (int i = threadIdx.x; i < (1 << HUF_LMAX); i += blockDim.x) {
+        lut[i] = lut_g[i];
+    }
+}
+
+template <int C>
+__global__ void __launch_bounds__(256) k_huffman_mmv(const huf_ptrs w, int R, cols_t p) {
+    constexpr int K = C * 512;
+    extern __shared__ float shm[];
+    float * xs = shm;
+    uint32_t * lut = (uint32_t *) (shm + K);
+    const float * xg; float * out; int64_t rbase;
+    col_setup(p, blockIdx.y, xg, out, rbase);
+    stage<C>(xs, lut, xg, w.lut);
+    __syncthreads();
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    const int64_t units = p.nrows / R;
+    for (int64_t u = blockIdx.x * 8 + warp; u < units; u += gridDim.x * 8) {
+        const int64_t gu = rbase / R + u;
+        huf_state st;
+        huf_init(st, w, gu, lane);
+        for (int rr = 0; rr < R; rr++) {
+            const float v = huf_row_dot<C>(st, w.sm, lut, gu * R + rr, xs, lane);
+            if (lane == 0) {
+                out[u * R + rr] = v;
+            }
+        }
+    }
+}
+
+template <int C, int R>
+__global__ void __launch_bounds__(256) k_huffman_mmv_glu(const huf_ptrs g, const huf_ptrs w_up, cols_t p) {
+    constexpr int K = C * 512;
+    extern __shared__ float shm[];
+    float * xs = shm;
+    uint32_t * lut_g = (uint32_t *) (shm + K);
+    uint32_t * lut_u = lut_g + (1 << HUF_LMAX);
+    const float * xg; float * out; int64_t rbase;
+    col_setup(p, blockIdx.y, xg, out, rbase);
+    stage<C>(xs, lut_g, xg, g.lut);
+    for (int i = threadIdx.x; i < (1 << HUF_LMAX); i += blockDim.x) {
+        lut_u[i] = w_up.lut[i];
+    }
+    __syncthreads();
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    const int64_t units = p.nrows / R;
+    for (int64_t u = blockIdx.x * 8 + warp; u < units; u += gridDim.x * 8) {
+        const int64_t gu = rbase / R + u;
+        float gv[R];
+        {
+            huf_state st;
+            huf_init(st, g, gu, lane);
+#pragma unroll
+            for (int rr = 0; rr < R; rr++) {
+                gv[rr] = huf_row_dot<C>(st, g.sm, lut_g, gu * R + rr, xs, lane);
+            }
+        }
+        huf_state st;
+        huf_init(st, w_up, gu, lane);
+#pragma unroll
+        for (int rr = 0; rr < R; rr++) {
+            const float uv = huf_row_dot<C>(st, w_up.sm, lut_u, gu * R + rr, xs, lane);
+            if (lane == 0) {
+                out[u * R + rr] = uv * ggml_cuda_op_silu_single(gv[rr]);
+            }
+        }
+    }
+}
+
+// exact reconstruction to BF16 (row-major, contiguous) for the batched cuBLAS path
+template <int C>
+__global__ void __launch_bounds__(256) k_nibble_dequant(const uint8_t * __restrict__ sm, const uint8_t * __restrict__ nib,
+        const uint4 * __restrict__ lut_row, const uint32_t * __restrict__ esc_off, const uint32_t * __restrict__ esc,
+        int64_t row0, int64_t nrows, uint16_t * __restrict__ out) {
+    constexpr int K = C * 512;
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    for (int64_t r = blockIdx.x * 8 + warp; r < nrows; r += gridDim.x * 8) {
+        const int64_t gr = row0 + r;
+        const uint4 L = __ldg(lut_row + gr);
+        uint16_t * o = out + r * K;
+        for (int c = 0; c < C; c++) {
+            const uint4 smv = __ldg((const uint4 *) (sm + gr * K + c * 512) + lane);
+            const uint2 nbv = __ldg((const uint2 *) (nib + gr * (K / 2) + c * 256) + lane);
+            const uint32_t smw[4] = {smv.x, smv.y, smv.z, smv.w};
+            const uint32_t nw[2] = {nbv.x, nbv.y};
+#pragma unroll
+            for (int j = 0; j < 4; j++) {
+                const uint32_t sel = (j & 1) ? (nw[j >> 1] >> 16) : nw[j >> 1];
+                const uint32_t E4 = prmt(L.x, L.y, sel) | prmt(L.z, L.w, sel ^ 0x8888u);
+                const uint32_t w0 = (prmt(smw[j], 0, 0x9180u) & 0x807F807Fu) | (prmt(E4, 0, 0x4140u) << 7);
+                const uint32_t w1 = (prmt(smw[j], 0, 0xB3A2u) & 0x807F807Fu) | (prmt(E4, 0, 0x4342u) << 7);
+                *(uint2 *) (o + c * 512 + 128 * j + 4 * lane) = make_uint2(w0, w1);
+            }
+        }
+        __syncwarp();
+        for (uint32_t i = esc_off[gr] + lane; i < esc_off[gr + 1]; i += 32) {
+            const uint32_t rec = esc[i];
+            const uint32_t smb = (rec >> 12) & 0xFF, ex = rec >> 20;
+            o[rec & 0xFFF] = (uint16_t) (((smb & 0x80) << 8) | (ex << 7) | (smb & 0x7F));
+        }
+    }
+}
+
+template <int C>
+__global__ void __launch_bounds__(256) k_huffman_dequant(const uint8_t * __restrict__ sm, const uint32_t * __restrict__ lut_g,
+        const uint32_t * __restrict__ lane_off, const uint32_t * __restrict__ stream, int R, int64_t row0, int64_t nrows,
+        uint16_t * __restrict__ out) {
+    constexpr int K = C * 512;
+    __shared__ uint32_t lut[1 << HUF_LMAX];
+    for (int i = threadIdx.x; i < (1 << HUF_LMAX); i += blockDim.x) {
+        lut[i] = lut_g[i];
+    }
+    __syncthreads();
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    for (int64_t u = blockIdx.x * 8 + warp; u < nrows / R; u += gridDim.x * 8) {
+        const int64_t gu = row0 / R + u;
+        const uint32_t * sp = stream + lane_off[gu * 32 + lane];
+        uint32_t hi = sp[0], lo = sp[1], nw0 = sp[2], nw1 = sp[3];
+        sp += 4;
+        int nbits = 64;
+        uint32_t acc = 0, acc_chk = 0;
+        for (int rr = 0; rr < R; rr++) {
+            const int64_t gr = gu * R + rr;
+            uint16_t * o = out + (gr - row0) * K;
+            for (int c = 0; c < C; c++) {
+                const uint4 smv = __ldg((const uint4 *) (sm + gr * K + c * 512) + lane);
+                const uint32_t smw[4] = {smv.x, smv.y, smv.z, smv.w};
+                uint32_t ex[16];
+#pragma unroll
+                for (int s = 0; s < 16; s++) {
+                    if (s % HUF_GROUP == 0) {
+                        nbits -= (int) ((acc - acc_chk) & 127u);
+                        acc_chk = acc;
+                        if (nbits <= 32) {
+                            const uint32_t sh = 32 - nbits;
+                            hi |= __funnelshift_lc(nw0, 0u, sh);
+                            lo |= __funnelshift_lc(0u, nw0, sh);
+                            nbits += 32; nw0 = nw1; nw1 = *sp++;
+                        }
+                    }
+                    const uint32_t ent = lut[__umulhi(hi, 1u << HUF_LMAX)];
+                    hi = __funnelshift_l(lo, hi, ent);
+                    lo = __funnelshift_l(0u, lo, ent);
+                    acc += ent;
+                    ex[s] = ent;
+                }
+#pragma unroll
+                for (int j = 0; j < 4; j++) {
+                    const uint32_t w0 = sel_bits(prmt(smw[j], 0, 0x9180u), prmt(ex[4 * j], ex[4 * j + 1], 0x5410u));
+                    const uint32_t w1 = sel_bits(prmt(smw[j], 0, 0xB3A2u), prmt(ex[4 * j + 2], ex[4 * j + 3], 0x5410u));
+                    *(uint2 *) (o + c * 512 + 128 * j + 4 * lane) = make_uint2(w0, w1);
+                }
+            }
+        }
+    }
+}
+
+int sm_count() {
+    static int n = 0;
+    if (!n) {
+        int dev;
+        CUDA_CHECK(cudaGetDevice(&dev));
+        CUDA_CHECK(cudaDeviceGetAttribute(&n, cudaDevAttrMultiProcessorCount, dev));
+    }
+    return n;
+}
+
+
+struct hp_ptrs { const uint8_t * sm; const uint32_t * lut; const uint32_t * ubase; const uint16_t * lrel; const uint32_t * stream; };
+
+__device__ __forceinline__ uint4 ld_plane(const uint4 * p) { // streamed once: keep it out of L1 (the lane streams live there)
+    uint4 v;
+    asm volatile("ld.global.nc.L1::no_allocate.v4.u32 {%0,%1,%2,%3}, [%4];" : "=r"(v.x), "=r"(v.y), "=r"(v.z), "=r"(v.w) : "l"(p));
+    return v;
+}
+
+__device__ __forceinline__ uint64_t shl64w(uint64_t b, uint32_t n) { // {hi:lo} <<= (n & 31)
+    uint64_t d;
+    asm("{.reg .b32 l, h; mov.b64 {l, h}, %1; shf.l.wrap.b32 h, l, h, %2; shf.l.wrap.b32 l, 0, l, %2; mov.b64 %0, {l, h};}" : "=l"(d) : "l"(b), "r"(n));
+    return d;
+}
+
+// per-warp decoder state for one unit (bit buffer MSB-first; v = valid bits, exact in its low 7 bits)
+#define HP_UNIT_BEGIN(W, GU)                                                                         \
+    const uint32_t * lst = (W).stream;                                                               \
+    uint32_t idx = __ldg((W).ubase + (GU)) + __ldg((W).lrel + (GU) * 32 + lane);                      \
+    uint64_t buf = (uint64_t) __ldg(lst + idx) << 32;                                                \
+    uint32_t wq[HP_PF];                                                                              \
+    _Pragma("unroll") for (int i_ = 0; i_ < HP_PF; i_++) { wq[i_] = __ldg(lst + idx + 1 + i_); }    \
+    idx += 1 + HP_PF;                                                                                \
+    uint32_t v = 32, pa = 0, pb = 0;
+
+// re-point the decoder state declared by HP_UNIT_BEGIN at another unit
+#define HP_UNIT_RESET(W, GU)                                                                         \
+    idx = __ldg((W).ubase + (GU)) + __ldg((W).lrel + (GU) * 32 + lane);                               \
+    buf = (uint64_t) __ldg(lst + idx) << 32;                                                         \
+    _Pragma("unroll") for (int i_ = 0; i_ < HP_PF; i_++) { wq[i_] = __ldg(lst + idx + 1 + i_); }    \
+    idx += 1 + HP_PF;                                                                                \
+    v = 32; pa = 0; pb = 0;
+
+// decode one row (C chunks) and leave dot(row, x) summed over the warp in ACC
+#define HP_ROW(SM, GR, ACC)                                                                          \
+    {                                                                                                \
+        const uint8_t * rp_ = (SM) + (GR) * K;                                                       \
+        uint4 smv_[C];                                                                               \
+        _Pragma("unroll") for (int c_ = 0; c_ < C; c_++) { smv_[c_] = ld_plane((const uint4 *) (rp_ + c_ * 512) + lane); } \
+        float a0_ = 0.f, a1_ = 0.f, a2_ = 0.f, a3_ = 0.f;                                            \
+        _Pragma("unroll") for (int c_ = 0; c_ < C; c_++) {                                           \
+            const uint32_t smw_[4] = {smv_[c_].x, smv_[c_].y, smv_[c_].z, smv_[c_].w};               \
+            uint32_t ex_[8];                                                                         \
+            _Pragma("unroll") for (int q_ = 0; q_ < 8; q_++) {                                       \
+                if (q_ % 2 == 0) {                                                                   \
+                    v = v - pa - pb;                                                                 \
+                    const uint32_t m_ = __funnelshift_r(0u, 1u, v);                                  \
+                    if (!(v & 32u)) {                                                                \
+                        buf += (uint64_t) wq[0] * m_;                                                \
+                        _Pragma("unroll") for (int i_ = 0; i_ + 1 < HP_PF; i_++) { wq[i_] = wq[i_ + 1]; } \
+                        wq[HP_PF - 1] = __ldg(lst + idx);                                            \
+                        idx++;                                                                       \
+                    }                                                                                \
+                    v |= 32u;                                                                        \
+                }                                                                                    \
+                const uint32_t ent_ = lut[(uint32_t) (buf >> 32) >> (32 - HP_LP)];                   \
+                buf = shl64w(buf, ent_);                                                             \
+                ex_[q_] = ent_;                                                                      \
+                if (q_ % 2 == 0) { pa = ent_; } else { pb = ent_; }                                  \
+            }                                                                                        \
+            _Pragma("unroll") for (int j_ = 0; j_ < 4; j_++) {                                       \
+                const float4 xv_ = XREG_C1 ? xr[j_] : *(const float4 *) (xs + c_ * 512 + 128 * j_ + 4 * lane); \
+                const uint32_t w0_ = sel_bits(prmt(smw_[j_], 0, 0x9180u), ex_[2 * j_]);              \
+                const uint32_t w1_ = sel_bits(prmt(smw_[j_], 0, 0xB3A2u), ex_[2 * j_ + 1]);          \
+                a0_ = fmaf(__uint_as_float(w0_ << 16), xv_.x, a0_);                                  \
+                a1_ = fmaf(__uint_as_float(w0_ & 0xFFFF0000u), xv_.y, a1_);                          \
+                a2_ = fmaf(__uint_as_float(w1_ << 16), xv_.z, a2_);                                  \
+                a3_ = fmaf(__uint_as_float(w1_ & 0xFFFF0000u), xv_.w, a3_);                          \
+            }                                                                                        \
+        }                                                                                            \
+        ACC = warp_sum((a0_ + a1_) + (a2_ + a3_));                                                   \
+    }
+
+#define HP_STAGE(XG, LUT_SRC, LUT_DST)                                                               \
+    for (int i_ = threadIdx.x; i_ < K; i_ += blockDim.x) { xs[i_] = (XG)[i_]; }                     \
+    for (int i_ = threadIdx.x; i_ < (1 << HP_LP); i_ += blockDim.x) { (LUT_DST)[i_] = (LUT_SRC)[i_]; }
+
+#define HP_XREG                                                                                      \
+    constexpr bool XREG_C1 = C == 1; /* K=512: this lane's 16 activations stay in registers */      \
+    float4 xr[4];                                                                                    \
+    if (XREG_C1) { _Pragma("unroll") for (int j_ = 0; j_ < 4; j_++) { xr[j_] = *(const float4 *) (xs + 128 * j_ + 4 * lane); } }
+
+template <int C>
+__global__ void __launch_bounds__(HP_NT) k_hp_mmv(const hp_ptrs w, int R, cols_t p) {
+    constexpr int K = C * 512;
+    extern __shared__ float shm[];
+    float * xs = shm;
+    uint32_t * lut = (uint32_t *) (shm + K);
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    const int wpb = blockDim.x >> 5;
+    const int t = threadIdx.x;
+    // warm start: issue every independent load of the prologue (LUT, ids -> x, the first unit's stream words) before
+    // the first use, so their latencies overlap instead of stalling the in-order issue one after another
+    const bool one_pass = blockDim.x * 4 >= (1 << HP_LP) && blockDim.x * 4 >= K;
+    uint4 l4 = make_uint4(0, 0, 0, 0);
+    if (one_pass && t < (1 << HP_LP) / 4) {
+        l4 = __ldg((const uint4 *) w.lut + t);
+    }
+    const float * xg; float * out; int64_t rbase;
+    col_setup(p, blockIdx.y, xg, out, rbase);
+    float4 x4 = make_float4(0.f, 0.f, 0.f, 0.f);
+    if (one_pass && t < K / 4) {
+        x4 = __ldg((const float4 *) xg + t);
+    }
+    const int64_t units = p.nrows / R;
+    const int64_t u0 = blockIdx.x * wpb + warp;
+    HP_UNIT_BEGIN(w, rbase / R + (u0 < units ? u0 : 0))
+    if (one_pass) {
+        if (t < (1 << HP_LP) / 4) {
+            ((uint4 *) lut)[t] = l4;
+        }
+        if (t < K / 4) {
+            ((float4 *) xs)[t] = x4;
+        }
+    } else {
+        HP_STAGE(xg, w.lut, lut)
+    }
+    __syncthreads();
+    HP_XREG
+    for (int64_t u = u0; u < units; u += gridDim.x * wpb) {
+        const int64_t gu = rbase / R + u;
+        if (u != u0) {
+            HP_UNIT_RESET(w, gu)
+        }
+        for (int rr = 0; rr < R; rr++) {
+            float acc;
+            HP_ROW(w.sm, gu * R + rr, acc)
+            if (lane == 0) {
+                out[u * R + rr] = acc;
+            }
+        }
+    }
+}
+
+template <int C, int R>
+__global__ void __launch_bounds__(HP_NT) k_hp_mmv_glu(const hp_ptrs g, const hp_ptrs wu, cols_t p) {
+    constexpr int K = C * 512;
+    extern __shared__ float shm[];
+    float * xs = shm;
+    uint32_t * lut_g = (uint32_t *) (shm + K);
+    uint32_t * lut_u = lut_g + (1 << HP_LP);
+    const float * xg; float * out; int64_t rbase;
+    col_setup(p, blockIdx.y, xg, out, rbase);
+    HP_STAGE(xg, g.lut, lut_g)
+    for (int i_ = threadIdx.x; i_ < (1 << HP_LP); i_ += blockDim.x) { lut_u[i_] = wu.lut[i_]; }
+    __syncthreads();
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    HP_XREG
+    const int64_t units = p.nrows / R;
+    const int wpb = blockDim.x >> 5;
+    for (int64_t u = blockIdx.x * wpb + warp; u < units; u += gridDim.x * wpb) {
+        const int64_t gu = rbase / R + u;
+        float gv[R];
+        {
+            const uint32_t * lut = lut_g;
+            HP_UNIT_BEGIN(g, gu)
+            _Pragma("unroll") for (int rr = 0; rr < R; rr++) {
+                HP_ROW(g.sm, gu * R + rr, gv[rr])
+            }
+        }
+        {
+            const uint32_t * lut = lut_u;
+            HP_UNIT_BEGIN(wu, gu)
+            _Pragma("unroll") for (int rr = 0; rr < R; rr++) {
+                float uv;
+                HP_ROW(wu.sm, gu * R + rr, uv)
+                if (lane == 0) {
+                    out[u * R + rr] = uv * ggml_cuda_op_silu_single(gv[rr]);
+                }
+            }
+        }
+    }
+}
+
+template <int C>
+__global__ void __launch_bounds__(256) k_hp_dequant(const hp_ptrs w, int R, int64_t row0, int64_t nrows, uint16_t * __restrict__ out) {
+    constexpr int K = C * 512;
+    __shared__ uint32_t lut[1 << HP_LP];
+    for (int i_ = threadIdx.x; i_ < (1 << HP_LP); i_ += blockDim.x) { lut[i_] = w.lut[i_]; }
+    __syncthreads();
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    for (int64_t u = blockIdx.x * 8 + warp; u < nrows / R; u += gridDim.x * 8) {
+        const int64_t gu = row0 / R + u;
+        HP_UNIT_BEGIN(w, gu)
+        for (int rr = 0; rr < R; rr++) {
+            const int64_t gr = gu * R + rr;
+            uint16_t * o = out + (gr - row0) * K;
+            for (int c = 0; c < C; c++) {
+                const uint4 smv = ld_plane((const uint4 *) (w.sm + gr * K + c * 512) + lane);
+                const uint32_t smw[4] = {smv.x, smv.y, smv.z, smv.w};
+                uint32_t ex[8];
+#pragma unroll
+                for (int q = 0; q < 8; q++) {
+                    if (q % 2 == 0) {
+                        v = v - pa - pb;
+                        const uint32_t m = __funnelshift_r(0u, 1u, v);
+                        if (!(v & 32u)) {
+                            buf += (uint64_t) wq[0] * m;
+#pragma unroll
+                            for (int i = 0; i + 1 < HP_PF; i++) { wq[i] = wq[i + 1]; }
+                            wq[HP_PF - 1] = __ldg(lst + idx);
+                            idx++;
+                        }
+                        v |= 32u;
+                    }
+                    const uint32_t ent = lut[(uint32_t) (buf >> 32) >> (32 - HP_LP)];
+                    buf = shl64w(buf, ent);
+                    ex[q] = ent;
+                    if (q % 2 == 0) { pa = ent; } else { pb = ent; }
+                }
+#pragma unroll
+                for (int j = 0; j < 4; j++) {
+                    const uint32_t w0 = sel_bits(prmt(smw[j], 0, 0x9180u), ex[2 * j]);
+                    const uint32_t w1 = sel_bits(prmt(smw[j], 0, 0xB3A2u), ex[2 * j + 1]);
+                    *(uint2 *) (o + c * 512 + 128 * j + 4 * lane) = make_uint2(w0, w1);
+                }
+            }
+        }
+    }
+}
+
+
+// GET_ROWS (token embedding): dst[:, i] = float(W[ids[i], :]); one warp per requested row
+template <int C>
+__global__ void __launch_bounds__(256) k_nibble_get_rows(const nib_ptrs w, const char * __restrict__ ids, int64_t ids_s0,
+        int64_t n, int64_t row0, float * __restrict__ dst, int64_t dst_s1) {
+    constexpr int K = C * 512;
+    const int lane = threadIdx.x & 31;
+    const int64_t i = blockIdx.x * (int64_t) (blockDim.x >> 5) + (threadIdx.x >> 5);
+    if (i >= n) {
+        return;
+    }
+    const int64_t gr = row0 + *(const int32_t *) (ids + i * ids_s0);
+    float * o = (float *) ((char *) dst + i * dst_s1);
+    const uint4 L = __ldg(w.lut_row + gr);
+    for (int c = 0; c < C; c++) {
+        const uint4 smv = __ldg((const uint4 *) (w.sm + gr * K + c * 512) + lane);
+        const uint2 nbv = __ldg((const uint2 *) (w.nib + gr * (K / 2) + c * 256) + lane);
+        const uint32_t smw[4] = {smv.x, smv.y, smv.z, smv.w};
+        const uint32_t nw[2] = {nbv.x, nbv.y};
+#pragma unroll
+        for (int j = 0; j < 4; j++) {
+            const uint32_t sel = (j & 1) ? (nw[j >> 1] >> 16) : nw[j >> 1];
+            const uint32_t E4 = prmt(L.x, L.y, sel) | prmt(L.z, L.w, sel ^ 0x8888u);
+            const uint32_t w0 = (prmt(smw[j], 0, 0x9180u) & 0x807F807Fu) | (prmt(E4, 0, 0x4140u) << 7);
+            const uint32_t w1 = (prmt(smw[j], 0, 0xB3A2u) & 0x807F807Fu) | (prmt(E4, 0, 0x4342u) << 7);
+            *(float4 *) (o + c * 512 + 128 * j + 4 * lane) = make_float4(
+                __uint_as_float(w0 << 16), __uint_as_float(w0 & 0xFFFF0000u), __uint_as_float(w1 << 16), __uint_as_float(w1 & 0xFFFF0000u));
+        }
+    }
+    __syncwarp();
+    for (uint32_t e = w.esc_off[gr] + lane; e < w.esc_off[gr + 1]; e += 32) {
+        const uint32_t rec = w.esc[e];
+        const uint32_t smb = (rec >> 12) & 0xFF, ex = rec >> 20;
+        o[rec & 0xFFF] = __uint_as_float((((smb & 0x80) << 8) | (ex << 7) | (smb & 0x7F)) << 16);
+    }
+}
+
+// the warp decodes its row's unit from the start and writes only the requested row
+template <int C>
+__global__ void __launch_bounds__(256) k_hp_get_rows(const hp_ptrs w, int R, const char * __restrict__ ids, int64_t ids_s0,
+        int64_t n, int64_t row0, float * __restrict__ dst, int64_t dst_s1) {
+    constexpr int K = C * 512;
+    __shared__ uint32_t lut[1 << HP_LP];
+    for (int i_ = threadIdx.x; i_ < (1 << HP_LP); i_ += blockDim.x) { lut[i_] = w.lut[i_]; }
+    __syncthreads();
+    const int lane = threadIdx.x & 31;
+    const int64_t i = blockIdx.x * (int64_t) (blockDim.x >> 5) + (threadIdx.x >> 5);
+    if (i >= n) {
+        return;
+    }
+    const int64_t gr = row0 + *(const int32_t *) (ids + i * ids_s0);
+    const int64_t gu = gr / R;
+    float * o = (float *) ((char *) dst + i * dst_s1);
+    HP_UNIT_BEGIN(w, gu)
+    for (int64_t r = gu * R; r <= gr; r++) {
+        for (int c = 0; c < C; c++) {
+            const uint4 smv = ld_plane((const uint4 *) (w.sm + r * K + c * 512) + lane);
+            const uint32_t smw[4] = {smv.x, smv.y, smv.z, smv.w};
+            uint32_t ex[8];
+#pragma unroll
+            for (int q = 0; q < 8; q++) {
+                if (q % 2 == 0) {
+                    v = v - pa - pb;
+                    const uint32_t m = __funnelshift_r(0u, 1u, v);
+                    if (!(v & 32u)) {
+                        buf += (uint64_t) wq[0] * m;
+#pragma unroll
+                        for (int k = 0; k + 1 < HP_PF; k++) { wq[k] = wq[k + 1]; }
+                        wq[HP_PF - 1] = __ldg(lst + idx);
+                        idx++;
+                    }
+                    v |= 32u;
+                }
+                const uint32_t ent = lut[(uint32_t) (buf >> 32) >> (32 - HP_LP)];
+                buf = shl64w(buf, ent);
+                ex[q] = ent;
+                if (q % 2 == 0) { pa = ent; } else { pb = ent; }
+            }
+            if (r == gr) {
+#pragma unroll
+                for (int j = 0; j < 4; j++) {
+                    const uint32_t w0 = sel_bits(prmt(smw[j], 0, 0x9180u), ex[2 * j]);
+                    const uint32_t w1 = sel_bits(prmt(smw[j], 0, 0xB3A2u), ex[2 * j + 1]);
+                    *(float4 *) (o + c * 512 + 128 * j + 4 * lane) = make_float4(
+                        __uint_as_float(w0 << 16), __uint_as_float(w0 & 0xFFFF0000u), __uint_as_float(w1 << 16), __uint_as_float(w1 & 0xFFFF0000u));
+                }
+            }
+        }
+    }
+}
+
+nib_ptrs nibp(const entry & e) { return {e.base, e.nib, e.lut_row, e.esc_off, e.esc}; }
+huf_ptrs hufp(const entry & e) { return {e.base, e.hlut, e.lane_off, e.stream}; }
+hp_ptrs hpp(const entry & e) { return {e.base, e.hlut, e.lane_off, e.lane_rel, e.stream}; }
+
+// pair kernels: ~one 1024-thread block per SM when there is enough work; smaller blocks spread few units over all SMs
+void hp_launch_dims(const entry & e, int64_t nrows, int ncols, dim3 & grid, int & nt) {
+    const int64_t units = nrows / e.R;
+    const int64_t sms = sm_count();
+    const int64_t per_col = std::max<int64_t>(1, sms / std::max(1, ncols));
+    const int64_t warps_per_block = std::clamp<int64_t>((units + per_col - 1) / per_col, 2, HP_NT / 32);
+    nt = (int) warps_per_block * 32;
+    grid = dim3((unsigned) std::max<int64_t>(1, std::min<int64_t>((units + warps_per_block - 1) / warps_per_block, per_col)), ncols);
+}
+
+dim3 mmv_grid(const entry & e, int64_t nrows, int ncols) {
+    const int64_t work = e.format == GGML_BF16N_NIBBLE ? nrows : nrows / e.R; // rows or units, one warp each
+    const int64_t cap = std::max<int64_t>(1, (int64_t) sm_count() * 4 / std::min(ncols, 4));
+    return dim3((unsigned) std::max<int64_t>(1, std::min<int64_t>((work + 7) / 8, cap)), ncols);
+}
+
+void launch_mmv(const entry & e, const cols_t & p, int ncols, cudaStream_t stream) {
+    const int64_t K = e.K;
+    const dim3 grid = mmv_grid(e, p.nrows, ncols);
+    if (e.format == GGML_BF16N_HUFPAIR) {
+        dim3 g2; int nt;
+        hp_launch_dims(e, p.nrows, ncols, g2, nt);
+        const size_t shm = K * sizeof(float) + (4u << HP_LP);
+#define HP_CASE(CC) case CC: k_hp_mmv<CC><<<g2, nt, shm, stream>>>(hpp(e), e.R, p); break;
+        switch (K / 512) { HP_CASE(1) HP_CASE(2) HP_CASE(4) HP_CASE(8) default: GGML_ABORT("bf16n: unsupported K"); }
+#undef HP_CASE
+    } else if (e.format == GGML_BF16N_NIBBLE) {
+#define NIB_CASE(CC) case CC: k_nibble_mmv<CC><<<grid, 256, 0, stream>>>(nibp(e), p); break;
+        switch (K / 512) { NIB_CASE(1) NIB_CASE(2) NIB_CASE(4) NIB_CASE(8) default: GGML_ABORT("bf16n: unsupported K"); }
+#undef NIB_CASE
+    } else {
+        const size_t shm = K * sizeof(float) + (4u << HUF_LMAX);
+#define HUF_CASE(CC) case CC: k_huffman_mmv<CC><<<grid, 256, shm, stream>>>(hufp(e), e.R, p); break;
+        switch (K / 512) { HUF_CASE(1) HUF_CASE(2) HUF_CASE(4) HUF_CASE(8) default: GGML_ABORT("bf16n: unsupported K"); }
+#undef HUF_CASE
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void launch_mmv_glu(const entry & g, const entry & u, const cols_t & p, int ncols, cudaStream_t stream) {
+    const int64_t K = g.K;
+    const dim3 grid = mmv_grid(g, p.nrows, ncols);
+    if (g.format == GGML_BF16N_HUFPAIR) {
+        dim3 g2; int nt;
+        hp_launch_dims(g, p.nrows, ncols, g2, nt);
+        const size_t shm = K * sizeof(float) + (8u << HP_LP);
+#define HP_CASE(CC, RR) case CC * 100 + RR: k_hp_mmv_glu<CC, RR><<<g2, nt, shm, stream>>>(hpp(g), hpp(u), p); break;
+#define HP_CASES(RR) HP_CASE(1, RR) HP_CASE(2, RR) HP_CASE(4, RR) HP_CASE(8, RR)
+        switch ((K / 512) * 100 + g.R) {
+            HP_CASES(1) HP_CASES(2) HP_CASES(4) HP_CASES(8) HP_CASES(16)
+            default: GGML_ABORT("bf16n: unsupported K/R for glu");
+        }
+#undef HP_CASES
+#undef HP_CASE
+    } else if (g.format == GGML_BF16N_NIBBLE) {
+#define NIB_CASE(CC) case CC: k_nibble_mmv_glu<CC><<<grid, 256, 0, stream>>>(nibp(g), nibp(u), p); break;
+        switch (K / 512) { NIB_CASE(1) NIB_CASE(2) NIB_CASE(4) NIB_CASE(8) default: GGML_ABORT("bf16n: unsupported K"); }
+#undef NIB_CASE
+    } else {
+        const size_t shm = K * sizeof(float) + (8u << HUF_LMAX);
+#define HUF_CASE(CC, RR) case CC * 100 + RR: k_huffman_mmv_glu<CC, RR><<<grid, 256, shm, stream>>>(hufp(g), hufp(u), p); break;
+        switch ((K / 512) * 100 + g.R) {
+            HUF_CASE(1, 8) HUF_CASE(2, 8) HUF_CASE(4, 8) HUF_CASE(8, 8)
+            HUF_CASE(1, 16) HUF_CASE(2, 16) HUF_CASE(4, 16) HUF_CASE(8, 16)
+            default: GGML_ABORT("bf16n: unsupported K/R for glu");
+        }
+#undef HUF_CASE
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void launch_dequant(const entry & e, int64_t row0, int64_t nrows, uint16_t * out, cudaStream_t stream) {
+    const int64_t work = e.format == GGML_BF16N_NIBBLE ? nrows : nrows / e.R;
+    const int gx = (int) std::max<int64_t>(1, std::min<int64_t>((work + 7) / 8, (int64_t) sm_count() * 16));
+    if (e.format != GGML_BF16N_NIBBLE) {
+        GGML_ASSERT(nrows % e.R == 0 && row0 % e.R == 0);
+    }
+#define DQ(CC)                                                                                                         \
+    case CC:                                                                                                           \
+        if (e.format == GGML_BF16N_NIBBLE) {                                                                           \
+            k_nibble_dequant<CC><<<gx, 256, 0, stream>>>(e.base, e.nib, e.lut_row, e.esc_off, e.esc, row0, nrows, out); \
+        } else if (e.format == GGML_BF16N_HUFPAIR) {                                                                   \
+            k_hp_dequant<CC><<<gx, 256, 0, stream>>>(hpp(e), e.R, row0, nrows, out);                                    \
+        } else {                                                                                                       \
+            k_huffman_dequant<CC><<<gx, 256, 0, stream>>>(e.base, e.hlut, e.lane_off, e.stream, e.R, row0, nrows, out); \
+        }                                                                                                              \
+        break;
+    switch (e.K / 512) { DQ(1) DQ(2) DQ(4) DQ(8) default: GGML_ABORT("bf16n: unsupported K"); }
+#undef DQ
+    CUDA_CHECK(cudaGetLastError());
+}
+
+cols_t make_cols(const ggml_tensor * src0, int64_t row0, const ggml_tensor * src1, const ggml_tensor * ids, const ggml_tensor * dst, int & ncols) {
+    cols_t p = {};
+    p.x = (const char *) src1->data;
+    p.dst = (char *) dst->data;
+    p.rows_per_matrix = src0->ne[1];
+    p.row0 = row0;
+    p.nrows = src0->ne[1];
+    if (ids) {
+        // src1: [K, ne11, ne12 tokens], ids: [n_used, tokens], dst: [N, n_used, tokens]
+        p.ids = (const char *) ids->data;
+        p.ids_s0 = ids->nb[0]; p.ids_s1 = ids->nb[1];
+        p.n_used = (int) ids->ne[0];
+        p.ne11 = (int) src1->ne[1];
+        p.x_slot = src1->nb[1]; p.x_tok = src1->nb[2];
+        p.dst_slot = dst->nb[1]; p.dst_tok = dst->nb[2];
+        ncols = (int) (ids->ne[0] * ids->ne[1]);
+    } else {
+        GGML_ASSERT(src0->ne[2] == 1 && src0->ne[3] == 1 && src1->ne[2] == 1 && src1->ne[3] == 1);
+        p.x_tok = src1->nb[1];
+        p.dst_tok = dst->nb[1];
+        ncols = (int) src1->ne[1];
+    }
+    return p;
+}
